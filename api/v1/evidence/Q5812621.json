[{"id":"P014f2dc2c3f12dc2","document_id":"D04f1808a4c58214f","char_start":205,"char_end":250,"reuse":"reusable","text":"P4647 premiere_venue: Teatro Apolo [Q5195517]"},{"id":"P019cd4e9d300a1eb","document_id":"Da4ba4fcce3e2d559","char_start":0,"char_end":197,"reuse":"reusable","text":"Doloretes es una zarzuela, en un acto y tres cuadros, sobre libreto de Carlos Arniches, con música de Amadeo Vives y Manuel Quislant, estrenada en el Teatro Apolo de Madrid el 28 de junio de 1901.​"},{"id":"P0a0bb148bf7cd096","document_id":"Daa988f22ffd4f01e","char_start":149,"char_end":210,"reuse":"reusable","text":"composer: Amadeo Vives [4fdbb51c-2a4b-4700-b2bb-1f8c833489cf]"},{"id":"P1e4671581476d881","document_id":"D04f1808a4c58214f","char_start":57,"char_end":98,"reuse":"reusable","text":"P86 composer: Manuel Quislant [Q20005455]"},{"id":"P2124e46c7ffae7ea","document_id":"Da4ba4fcce3e2d559","char_start":208,"char_end":456,"reuse":"reusable","text":"La obra –glosando por enésima vez el mito de “La Dolores”– se desarrolla en la zona rural de Alicante, en la época del estreno (1901), donde el tío Pere y la tía Tona viven preocupados por su nieto Visentico, en el frente de la guerra de Filipinas."},{"id":"P2f3f41c05f8a8da5","document_id":"Da4ba4fcce3e2d559","char_start":457,"char_end":737,"reuse":"reusable","text":"Al regreso de la guerra, Visentico descubre que su novia Doloretes le ha sido infiel con Nelo, el hijo del alcalde y del que Doloretes se ha enamorado. Visentico jura venganza, que se cumple cuando Nelo descubre que Doloretes había ya conocido a otros muchos hombres antes que él."},{"id":"P5991175dce983bc3","document_id":"D04f1808a4c58214f","char_start":142,"char_end":172,"reuse":"reusable","text":"P136 genre: zarzuela [Q148163]"},{"id":"P60a8d54c6a393d37","document_id":"Daa988f22ffd4f01e","char_start":211,"char_end":285,"reuse":"reusable","text":"librettist: Carlos Arniches Barreda [4dabe357-2d6b-42a8-b82d-3f84175fc8b7]"},{"id":"P6909bbf284f5173d","document_id":"D04f1808a4c58214f","char_start":99,"char_end":141,"reuse":"reusable","text":"P87 librettist: Carlos Arniches [Q1042706]"},{"id":"Pae176d47512c6005","document_id":"Da4ba4fcce3e2d559","char_start":1439,"char_end":1547,"reuse":"reusable","text":"Estrenada en 1923, fue dirigida por José Buchs, estuvo protagonizada por María Comendador y José Montenegro."},{"id":"Pc6454dd34fc14a40","document_id":"D04f1808a4c58214f","char_start":19,"char_end":56,"reuse":"reusable","text":"P86 composer: Amadeo Vives [Q2648593]"},{"id":"Pd8aaf648efd228cd","document_id":"Daa988f22ffd4f01e","char_start":84,"char_end":148,"reuse":"reusable","text":"composer: Manuel Quislant [ec5d0913-f8ef-457b-bb02-c99119ced297]"},{"id":"Pe28a4a2e41066daf","document_id":"D04f1808a4c58214f","char_start":173,"char_end":204,"reuse":"reusable","text":"P1191 premiere_date: 1901-06-28"}]