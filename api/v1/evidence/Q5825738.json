[{"id":"P0f9ac53a22c34e9f","document_id":"D11f463953510ea67","char_start":71,"char_end":101,"reuse":"reusable","text":"P136 genre: zarzuela [Q148163]"},{"id":"P48e34f26d1824572","document_id":"Dcdf4295ed44329fe","char_start":0,"char_end":202,"reuse":"reusable","text":"El milagro de la Virgen es una zarzuela en tres actos (zarzuela grande), con música de Ruperto Chapí y libreto de Mariano Pina Domínguez. Se estrenó el 8 de octubre de 1884 en el Teatro Apolo de Madrid."},{"id":"P6ea6c69cc485daf7","document_id":"D11f463953510ea67","char_start":102,"char_end":147,"reuse":"reusable","text":"P4647 premiere_venue: Teatro Apolo [Q5195517]"},{"id":"P70a02dd66d20cf67","document_id":"Dcdf4295ed44329fe","char_start":203,"char_end":377,"reuse":"reusable","text":"Únicamente perdura en el repertorio una romanza para tenor, \"Flores purísimas\", grabada por varios cantantes líricos, entre ellos Enrico Caruso (1914) y Alfredo Kraus (1991)."},{"id":"Pb452cb7d5d6e17a7","document_id":"D11f463953510ea67","char_start":33,"char_end":70,"reuse":"reusable","text":"P86 composer: Ruperto Chapí [Q964682]"},{"id":"Pd6b6ed7feb0846c2","document_id":"De09597c3217e36e2","char_start":98,"char_end":160,"reuse":"reusable","text":"composer: Ruperto Chapí [12fa6992-f021-4c95-8e59-1177b2a2ece1]"},{"id":"Pf3d99f74597cc685","document_id":"De09597c3217e36e2","char_start":161,"char_end":234,"reuse":"reusable","text":"librettist: Mariano Pina Domínguez [362818c4-1379-480f-9610-f590c8815640]"}]