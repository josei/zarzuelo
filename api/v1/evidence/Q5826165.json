[{"id":"P0539c4236aad76dc","document_id":"Db43187f0c2bd6ca5","char_start":164,"char_end":247,"reuse":"reusable","text":"composer: Joaquín “Quinito” Valverde Sanjuán [94220d35-7e4f-4793-a2f0-53be23dd180f]"},{"id":"P1872d7297d90a712","document_id":"D829765cac2d6dcef","char_start":941,"char_end":1138,"reuse":"reusable","text":"Dos versiones, una de 1910 y otra dirigida en 1923 por José Buchs, con el siguiente reparto: Antonio Gil Varela, Ana María Ruiz de Leyva, Carmen Andrés, María Anaya, Celso Lucio y José Montenegro.."},{"id":"P277c26bf9926300e","document_id":"Da0e7aef86ca8b28a","char_start":249,"char_end":280,"reuse":"reusable","text":"P1191 premiere_date: 1904-07-01"},{"id":"P3e5a81ea7ce66b4f","document_id":"Db43187f0c2bd6ca5","char_start":323,"char_end":396,"reuse":"reusable","text":"librettist: Enrique García Álvarez [f5a71f61-9fd9-4b80-893e-037d4b4745e0]"},{"id":"P450d50c8609f20bc","document_id":"Da0e7aef86ca8b28a","char_start":27,"char_end":74,"reuse":"reusable","text":"P86 composer: Tomás López Torregrosa [Q6148557]"},{"id":"P465e2c25a2992205","document_id":"Da0e7aef86ca8b28a","char_start":281,"char_end":326,"reuse":"reusable","text":"P4647 premiere_venue: Teatro Apolo [Q5195517]"},{"id":"P6f315853b2caf4ee","document_id":"Da0e7aef86ca8b28a","char_start":125,"char_end":167,"reuse":"reusable","text":"P87 librettist: Carlos Arniches [Q1042706]"},{"id":"P8294e9ed531235ee","document_id":"Db43187f0c2bd6ca5","char_start":92,"char_end":163,"reuse":"reusable","text":"composer: Tomás López Torregrosa [d55945af-5d01-4501-b2e2-9c5be22ba346]"},{"id":"Pab9aed205e02cc8a","document_id":"Da0e7aef86ca8b28a","char_start":218,"char_end":248,"reuse":"reusable","text":"P136 genre: zarzuela [Q148163]"},{"id":"Pc7907527725885fb","document_id":"Da0e7aef86ca8b28a","char_start":75,"char_end":124,"reuse":"reusable","text":"P86 composer: Joaquín Valverde Sanjuán [Q6206552]"},{"id":"Pe9c1c318518f20a9","document_id":"Db43187f0c2bd6ca5","char_start":248,"char_end":322,"reuse":"reusable","text":"librettist: Carlos Arniches Barreda [4dabe357-2d6b-42a8-b82d-3f84175fc8b7]"},{"id":"Pe9c87bf455ff7fcc","document_id":"Da0e7aef86ca8b28a","char_start":168,"char_end":217,"reuse":"reusable","text":"P87 librettist: Enrique García Álvarez [Q5833326]"},{"id":"Pf39a45395356b678","document_id":"D829765cac2d6dcef","char_start":256,"char_end":502,"reuse":"reusable","text":"Valbuena es un personaje apocado y tímido ante las mujeres. Frente a él, Salustiano ha ganado buena fama de conquistador que seduce a una tras otra. A Valbuena solo le queda el recurso de fingir estar accidentado para atraer la atención femenina."},{"id":"Pf3eb38a5eeca866a","document_id":"D829765cac2d6dcef","char_start":0,"char_end":245,"reuse":"reusable","text":"El pobre Valbuena es un sainete de Carlos Arniches y Enrique García Álvarez, en un acto dividido en tres cuadros, estrenado como zarzuela con música de Tomás López Torregrosa y Quinito Valverde en el Teatro Apolo de Madrid el 1 de julio de 1904."}]