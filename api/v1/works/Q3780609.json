ilies":["wikimedia"],"property":"performer","value":"kb:9bd567f8c4ec","value_label":"Plácido Domingo Ferrer","value_link":null,"value_type":"entity","status":"asserted","hedge":null,"confidence":0.5,"source_kind":"extracted","evidence_ids":["P3cae26cc133c0b39"],"relations":[],"n_claims":2},{"id":"Cca59b40ca29052cc","wikidata_rank":null,"references":[],"alternative":false,"source_families":["wikimedia"],"property":"performer","value":"kb:cbba31020571","value_label":"Pepita Embil","value_link":null,"value_type":"entity","status":"asserted","hedge":null,"confidence":0.5,"source_kind":"extracted","evidence_ids":["P3cae26cc133c0b39"],"relations":[],"n_claims":2},{"id":"C439492256eb13e5e","wikidata_rank":"normal","references":["Q8449"],"alternative":false,"source_families":["wikimedia"],"property":"premiere_venue","value":"Q6381861","value_label":"Teatro Calderón","value_link":"teatro","value_type":"entity","status":"asserted","hedge":null,"confidence":0.7,"source_kind":"structured","evidence_ids":["P8a5474f3e2d9d712","P2c296b12b39e56d0"],"relations":[],"n_claims":3},{"id":"C759544fc065b4f43","wikidata_rank":null,"references":[],"alternative":false,"source_families":["wikimedia"],"property":"revival_date","value":"1971","value_label":null,"value_link":null,"value_type":"edtf","status":"asserted","hedge":null,"confidence":0.5,"source_kind":"extracted","evidence_ids":["P3cae26cc133c0b39"],"relations":[],"n_claims":1},{"id":"C50476d4e315ab6df","wikidata_rank":"normal","references":[],"alternative":false,"source_families":["wikimedia"],"property":"premiere_date","value":"1932-03-26","value_label":null,"value_link":null,"value_type":"edtf","status":"asserted","hedge":null,"confidence":0.7,"source_kind":"structured","evidence_ids":["P1059dbca04df5f8f","P2c296b12b39e56d0"],"relations":[{"claim_a":"C50476d4e315ab6df","claim_b":"Cdd228ea6d49efc5b","relation":"supports"}],"n_claims":2}],"narratives":[],"biography":{"paragraphs":[{"passage_id":"P2c296b12b39e56d0","segments":[{"t":"Luisa Fernanda es una zarzuela, comedia lírica en tres actos, de "},{"t":"Federico Moreno Torroba","to":"/persona/Q471121"},{"t":" y libreto de "},{"t":"Federico Romero Sarachaga","to":"/persona/Q2071594"},{"t":" y "},{"t":"Guillermo Fernández-Shaw Iturralde","to":"/persona/Q4888937"},{"t":". Fue estrenada en el "},{"t":"Teatro Calderón de Madrid","to":"/teatro/Q6381861"},{"t":" el 26 de marzo de "},{"t":"1932","year":true},{"t":". Es la cuarta zarzuela de "},{"t":"Moreno Torroba","to":"/persona/Q471121"},{"t":", y su primer gran éxito. Se la considera una representante sobresaliente de ese género musical, y una de las más distinguidas de la literatura musical española. Algunas de sus frases forman ya parte de la cultura popular. Lleva más de 10 000 representaciones según algunos recuentos. La acción de esta zarzuela comienza en la ciudad de Madrid, durante el reinado de Isabel II, en los momentos previos a la revolución de "},{"t":"1868","year":true},{"t":", y acaba en una casa extremeña tras el destronamiento de Isabel II con La Gloriosa."}]},{"passage_id":"P3f3f151dd4b987dc","segments":[{"t":"En la plazuela de San Javier, la vida gira alrededor de la posada regentada por Mariana. Luisa Fernanda, una bella joven inquilina de la posada, está enamorada desde antiguo de Javier, militar que se considera su novio, pero que cada vez viene menos a visitarla, en particular desde su ascenso a coronel. En un momento en que Luisa Fernanda ha ido a la iglesia, aparece Javier por allí, logrando únicamente una reprimenda de Mariana por su informalidad. Por si lo anterior fuera poco, Aníbal, otro inquilino de la posada, le aplica un entusiasta pero atolondrado discurso liberal, ideología de la que es ferviente seguidor. Esta última conversación acaba cuando Aníbal se apercibe de que la Duquesa Carolina, que vive enfrente de la posada y tiene una declarada ideología monárquica, está en la ventana y podría oírlos."}]},{"passage_id":"Pb5d68d75b034f3f4","segments":[{"t":"Mariana preferiría que Luisa Fernanda, en vez de seguir bebiendo los vientos por Javier, atendiera los requerimientos de Vidal Hernando, un rico hacendado extremeño que la pretende, a pesar de ser bastante mayor que ella. Luisa Fernanda no cede y manifiesta a Vidal que está enamorada de otro hombre."}]},{"passage_id":"P45111f7db6aec648","segments":[{"t":"Vidal no pierde la esperanza, y, por ello, al enterarse por Aníbal de que Javier podría abrazar la causa liberal, se declara monárquico, menos por convicción personal que por llevar la contra a su antagonista."}]},{"passage_id":"Pfec1d55d455237cf","segments":[{"t":"Javier vuelve de nuevo en busca de Luisa Fernanda, pero se encuentra con Carolina que, mediante sus artes y encantos lo despista de Luisa y de paso lo atrae hacia la causa monárquica. Nogales, Aníbal y Vidal se asombran de ello al enterarse, y este último torna al punto sus ideas, declarándose liberal. Luisa Fernanda cuando se entera cae desmayada, no por política, por cierto."}]}],"document_id":"D8c022b05cae23d9b","license":"CC-BY-SA-4.0","revision":"172126758","url":"https://es.wikipedia.org/w/index.php?title=Luisa_Fernanda&oldid=172126758","history_url":"https://es.wikipedia.org/w/index.php?title=Luisa_Fernanda&action=history","retrieved_at":"2026-10-06T21:05:15Z"},"summary":null,"scores":[],"videos":[{"id":"jgzx1Ol7Goc","article_url":"https://es.wikipedia.org/wiki/Luisa_Fernanda#Enlaces_externos","title":"Zarzuela Luisa Fernanda con Pepita Embil 1971 (complete)","channel":"¡Viva la Ópera!","embeddable":true}],"documents":[],"documents_total":0,"rism":[],"rism_total":0,"rism_url":null}