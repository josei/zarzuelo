"role","value":"kb:be4cedb74fe2","value_label":"soprano","value_link":null,"value_type":"entity","status":"asserted","hedge":null,"confidence":0.5,"source_kind":"extracted","evidence_ids":["Pbc373092b96f4e35"],"relations":[],"n_claims":1},{"id":"C52bf75a9a33d8a9a","wikidata_rank":null,"references":[],"alternative":false,"source_families":["wikimedia"],"property":"premiere_date","value":"2010-11-07","value_label":null,"value_link":null,"value_type":"edtf","status":"asserted","hedge":null,"confidence":0.5,"source_kind":"extracted","evidence_ids":["Pbc373092b96f4e35"],"relations":[],"n_claims":1}],"narratives":[],"biography":{"paragraphs":[{"passage_id":"P960975d82e002245","segments":[{"t":"El patio florido es una ópera del compositor mexicano Manuel M. Ponce, que comenzó a escribirla a los 19 años de edad con la inspiración de su amiga Sandra V. Hernández, una joven escritora que compartía su pasión por el arte. Sandra, conocida por su aguda percepción y su sensibilidad literaria, se convirtió en una fuente constante de inspiración para Manuel."}]},{"passage_id":"P88ea10f70c679ffc","segments":[{"t":"Usó el libreto realizado por Carlos González Peña, escritor 3 años mayor que Ponce, nacido en Lagos de Moreno, Jalisco fue un escritor apasionado por las historias locales que retrataban las tradiciones, el folklore y los retos de su tierra natal. Aunque nació en una familia humilde, su talento para las letras comenzó a destacar desde joven. A lo largo de su vida, desarrolló un estilo literario único, que combinaba la poesía con un profundo análisis social y una mirada."}]},{"passage_id":"Pdca631a20a353499","segments":[{"t":"Ponce solo logró escribir el Duetino \"Imelda y Lía\", dentro del Acto 1, Preludio y Escena 1. Es un apunte que carece de orquestación, solo tiene acompañamiento al piano."}]},{"passage_id":"Pbc373092b96f4e35","segments":[{"t":"El estreno mundial de esta obra, junto con Cira, fue llevado a cabo en Aguascalientes Ags., México, el 7 de noviembre de "},{"t":"2010","year":true},{"t":" en el Teatro Morelos dentro del \"Festival Poncefonía "},{"t":"2010","year":true},{"t":"\". Fue presentada por la Camerata Ponce junto con Ana Cecilia Ramírez Acevedo (soprano) y Aida Alvarado Cortés (mezzosoprano)."}]}],"document_id":"D6b0ce7a518e2741b","license":"CC-BY-SA-4.0","revision":"165093717","url":"https://es.wikipedia.org/w/index.php?title=El_patio_florido&oldid=165093717","history_url":"https://es.wikipedia.org/w/index.php?title=El_patio_florido&action=history","retrieved_at":"2026-10-07T05:10:07Z"},"summary":{"segments":[{"text":"El patio florido es una ópera del compositor mexicano Manuel M. Ponce.","parts":[{"t":"El patio florido es una ópera del compositor mexicano Manuel M. Ponce."}],"evidence_ids":["P960975d82e002245"]},{"text":"Comenzó a escribirla a los 19 años de edad con la inspiración de su amiga Sandra V. Hernández.","parts":[{"t":"Comenzó a escribirla a los 19 años de edad con la inspiración de su amiga Sandra V. Hernández."}],"evidence_ids":["P960975d82e002245"]},{"text":"Usó el libreto realizado por Carlos González Peña.","parts":[{"t":"Usó el libreto realizado por Carlos González Peña."}],"evidence_ids":["P88ea10f70c679ffc"]}],"model":"bartowski/Qwen_Qwen3.5-4B-GGUF:Q5_K_M","generated_at":"2026-10-10T10:12:37Z","verified":true},"scores":[],"videos":[],"documents":[],"documents_total":0,"rism":[],"rism_total":0,"rism_url":null}