ty":"performer","value":"Q471121","value_label":"Federico Moreno Torroba","value_link":"persona","value_type":"entity","status":"asserted","hedge":null,"confidence":0.5,"source_kind":"extracted","evidence_ids":["P7b69d14ccd4b424e"],"relations":[],"n_claims":1},{"id":"Cdcb5dcc832844dd9","wikidata_rank":null,"references":[],"alternative":false,"source_families":["wikimedia"],"property":"performer","value":"kb:78674f7f04a5","value_label":"Coros y Danzas de la Sección Femenina","value_link":null,"value_type":"entity","status":"asserted","hedge":null,"confidence":0.5,"source_kind":"extracted","evidence_ids":["P7b69d14ccd4b424e"],"relations":[],"n_claims":1},{"id":"Cdfb13574450a191c","wikidata_rank":null,"references":[],"alternative":false,"source_families":["wikimedia"],"property":"performer","value":"kb:53ae951fba15","value_label":"Enrique del Portal","value_link":null,"value_type":"entity","status":"asserted","hedge":null,"confidence":0.5,"source_kind":"extracted","evidence_ids":["P7b69d14ccd4b424e"],"relations":[],"n_claims":1},{"id":"Cc9c0a010b8434950","wikidata_rank":null,"references":["Q8449"],"alternative":false,"source_families":["wikimedia"],"property":"premiere_venue","value":"Q5195517","value_label":"Teatro Apolo","value_link":"teatro","value_type":"entity","status":"asserted","hedge":null,"confidence":0.7,"source_kind":"structured","evidence_ids":["Pc3a8dcddb8372877","P3dd5e54bcdeeffed"],"relations":[],"n_claims":3},{"id":"C1f9860a6a0af95c1","wikidata_rank":null,"references":[],"alternative":false,"source_families":["wikimedia"],"property":"revival_date","value":"1972-07-22","value_label":null,"value_link":null,"value_type":"edtf","status":"asserted","hedge":null,"confidence":0.5,"source_kind":"extracted","evidence_ids":["P7b69d14ccd4b424e"],"relations":[],"n_claims":1},{"id":"Cb67db4294b292240","wikidata_rank":null,"references":[],"alternative":false,"source_families":["wikimedia"],"property":"premiere_date","value":"1926-12-03","value_label":null,"value_link":null,"value_type":"edtf","status":"asserted","hedge":null,"confidence":0.7,"source_kind":"structured","evidence_ids":["Pc3a8dcddb8372877","P07bc15f8a314a04e"],"relations":[{"claim_a":"Cb67db4294b292240","claim_b":"Cd0d8098b9b9d93f0","relation":"supports"}],"n_claims":2}],"narratives":[{"id":"N56beb43147e386ba","type":"anécdota","title":"Cervantes y la confusión que inspira La ilustre fregona","summary":"La figura de Miguel de Cervantes está presente en el mesón como huésped. Confunde a Constancica con una gran señora disfrazada de fregona, y al darse cuenta de su error, surge en su mente la idea de escribir, como así lo hizo, su novela ejemplar La ilustre fregona.","time":null,"status":"documented","evidence_ids":["P4cb386fbf813924e"]}],"biography":{"paragraphs":[{"passage_id":"Pc3a8dcddb8372877","segments":[{"t":"El huésped del sevillano es una zarzuela en dos actos estrenada el 3 de diciembre de "},{"t":"1926","year":true},{"t":" en el "},{"t":"Teatro Apolo de Madrid","to":"/teatro/Q5195517"},{"t":", con música de "},{"t":"Jacinto Guerrero","to":"/persona/Q3780233"},{"t":" y libreto de "},{"t":"Juan Ignacio Luca de Tena","to":"/persona/Q1609304"},{"t":" y "},{"t":"Enrique Reoyo","to":"/persona/Q20203555"},{"t":". Su éxito fue rotundo desde la primera representación y ha dado a la lírica alguna de sus piezas más representativas, como el celebérrimo «Canto a la espada», que forma parte del repertorio de todos los tenores hispanoparlantes de renombre."}]},{"passage_id":"Pf1e7d21a51a7f539","segments":[{"t":"El huésped del Sevillano es una historia llena de intrigas. El título hace alusión a que un personaje que aparece, el huésped del mesón El Sevillano en Toledo, es el escritor Miguel de Cervantes."}]},{"passage_id":"P633cad2c9d749e18","segments":[{"t":"En la imperial ciudad de Toledo, y a principios del siglo XVII, Juan Luis, un joven pintor de la corte, tiene el encargo del rey para que pinte una Virgen Inmaculada con destino al Real Oratorio. El artista espera encontrar en Toledo la modelo que le sirva para realizar su obra. Conoce a Raquel, mujer de belleza extraordinaria, hija de maese Andrés Munestein, e inmediatamente queda prendado de su belleza: es la mujer que busca para su cuadro. El conde don Diego, aprovechando la salida de la joven Raquel de su casa, camino de la iglesia, la hace su prisionera, llevándosela al Mesón del Sevillano, en espera de la ocasión para sacarla de la ciudad."}]},{"passage_id":"P4cb386fbf813924e","segments":[{"t":"El rapto de Raquel llena de indignación a Juan Luis, que está enamorado de ella. Constancica, moza del mesón, pone al corriente a Rodrigo, criado de Juan Luis, de todo lo que sabe respecto a la situación de Raquel: don Diego y sus secuaces preparan la fuga, huirán de la ciudad llevándose a su víctima. La llegada al mesón de un fraile encargado de transportar en una acémila varios hábitos con destino a su convento, le da la idea a Rodrigo de robar uno y disfrazarse de religioso para no despertar sospechas... La figura de Miguel de Cervantes está presente en el mesón como huésped. Confunde a Constancica con una gran señora disfrazada de fregona, y al darse cuenta de su error, surge en su mente la idea de escribir, como así lo hizo, su novela ejemplar La ilustre fregona."}]},{"passage_id":"P4acb704997ec1afe","segments":[{"t":"El pobre Rodrigo es descubierto por el conde y sus hombres, quienes se disponen a apalearle. Es en este momento cuando la justicia llama a la puerta del mesón. Los bandidos se ven descubiertos, y es Rodrigo quien les promete salvarles si le indultan del apaleamiento. Ellos acceden y Rodrigo les hace que se disfracen también de frailes. Así lo hacen, y cuando penetran los corchetes en el mesón, se encuentran con los cinco religiosos, falsos por supuesto, que se disponen a mortificarse como es costumbre en ellos, según indica Rodrigo, quien, cogiendo un vergajo, va atizando vergajazos a uno y otro aventurero, incluido don Diego, hasta hacerles ver las estrellas. Cuando ya se ha cansado de pegar, la entrada de Juan Luis hace ver toda la verdad a los representantes de la ley, que se llevan detenidos a los malhechores."}]}],"document_id":"D7722c7b8b3428ebd","license":"CC-BY-SA-4.0","revision":"174132092","url":"https://es.wikipedia.org/w/index.php?title=El_huésped_del_sevillano&oldid=174132092","history_url":"https://es.wikipedia.org/w/index.php?title=El_huésped_del_sevillano&action=history","retrieved_at":"2026-10-06T21:05:28Z"},"summary":null,"scores":[],"videos":[],"documents":[],"documents_total":0,"rism":[],"rism_total":0,"rism_url":null}