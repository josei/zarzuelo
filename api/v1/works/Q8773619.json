vidence_ids":["Pb8b22007c5d67b60","Pf28655dfdde30e12","Pd74a59e24ee28bac"],"relations":[],"n_claims":4},{"id":"C3c26f585ad081e57","wikidata_rank":null,"references":[],"alternative":false,"source_families":["wikimedia"],"property":"premiere_venue","value":"kb:ed218bd06d0f","value_label":"Teatro de la Zarzuela de Madrid (España)","value_link":null,"value_type":"entity","status":"asserted","hedge":null,"confidence":0.5,"source_kind":"extracted","evidence_ids":["Pf28655dfdde30e12"],"relations":[],"n_claims":1},{"id":"C70d88495110e2db1","wikidata_rank":null,"references":[],"alternative":false,"source_families":["wikimedia"],"property":"premiere_date","value":"1926-11-11","value_label":null,"value_link":null,"value_type":"edtf","status":"asserted","hedge":null,"confidence":0.5,"source_kind":"extracted","evidence_ids":["Pf28655dfdde30e12","Pd74a59e24ee28bac"],"relations":[{"claim_a":"C70d88495110e2db1","claim_b":"C9905c77bc0851a04","relation":"supports"},{"claim_a":"C70d88495110e2db1","claim_b":"Cc4832d9a38f8b409","relation":"supports"},{"claim_a":"C70d88495110e2db1","claim_b":"Ccc61de404ccf696f","relation":"supports"},{"claim_a":"C9905c77bc0851a04","claim_b":"Cc4832d9a38f8b409","relation":"supports"},{"claim_a":"C9905c77bc0851a04","claim_b":"Ccc61de404ccf696f","relation":"supports"},{"claim_a":"Cc4832d9a38f8b409","claim_b":"Ccc61de404ccf696f","relation":"supports"}],"n_claims":4}],"narratives":[{"id":"N807b140767a6e6e0","type":"curiosidad","title":"Concertante recortado en la grabación de 1954","summary":"En 1954, Ataúlfo Argenta la grabó por primera vez completa, con la Orquesta Nacional de España y el Orfeón Donostiarra y un reparto de lujo: Pilar Lorengar, Manuel Ausensi, Carlos Munguía, Julio Uribe, José María Maiza, Joaquina Belaustegui y María del Carmen Pérez Parral (Alhambra). Tiene recortada la segunda parte del concertante que cierra el primer acto.","time":"1954","status":"documented","evidence_ids":["Pa203def0b2b3ed9a"]}],"biography":{"paragraphs":[{"passage_id":"Pf28655dfdde30e12","segments":[{"t":"El caserío es una zarzuela de principios del siglo XX escrita por "},{"t":"Federico Romero","to":"/persona/Q2071594"},{"t":" y "},{"t":"Guillermo Fernández-Shaw","to":"/persona/Q4888937"},{"t":", con música de "},{"t":"Jesús Guridi","to":"/persona/Q978147"},{"t":". Se estrenó en el "},{"t":"Teatro de la Zarzuela","to":"/teatro/Q3321632"},{"t":" de Madrid (España) el 11 de noviembre de "},{"t":"1926","year":true},{"t":"."}]},{"passage_id":"P85ece10a85c31487","segments":[{"t":"El caserío es una comedia lírica en tres actos de carácter costumbrista, donde se expone la vida en una aldea campesina vasca contemporánea. Buena parte de la música está inspirada en el folclore vasco. Es una de las composiciones más importantes de Guridi."}]},{"passage_id":"Pd56076cd5a71fa20","segments":[{"t":"Se localiza en la aldea imaginaria de Arrigorri, en Vizcaya. Se presentan de una forma estereotipada personajes típicos: el cura, el alcalde, el secretario, el indiano rico, la tabernera... Usan un habla característica, con acentos y giros propios del país."}]},{"passage_id":"Pf81793fc300f173e","segments":[{"t":"Santi, indiano, soltero y alcalde de la aldea, vive en el caserío familiar llamado Sasibil. Con él viven sus dos sobrinos, primos entre sí: Ana Mari, hija de su hermano y de la mujer de la que Santi estuvo enamorado y con quien no pudo contraer matrimonio por tener que emigrar a América; y José Miguel, un joven pelotari que solo piensa en vivir la vida apurando la juventud."}]},{"passage_id":"P0b87d2c2fc229020","segments":[{"t":"El caserío, corazón de la familia vasca, debe permanecer intacto en el seno de la misma; por ello Santi ve como ideal el matrimonio entre sus sobrinos, el cual garantizaría esta premisa de transmisión del patrimonio y la felicidad de ambos. Pero la actitud de José Miguel le hace pensar que este usaría la herencia para seguir su \"diversión\", dejando en la ruina el patrimonio y a Ana Mari."}]},{"passage_id":"P452c9a7a415c3b1e","segments":[{"t":"El cura, uno de los poderes del pueblo junto con el alcalde, le aconseja que realice la estrategia de anunciar su propia boda para que así José Miguel se decida a asentar la cabeza o a abandonar el pueblo al ser evidente que no podrá heredar."}]},{"passage_id":"P6e03470a664719d4","segments":[{"t":"Ana Mari está enamorada de su primo José Miguel, pero este, en aras de la diversión sin límite, no le hace ningún caso. Este amor se cruza con el que Txomin, criado del caserío, siente por Ana Mari, un amor casi imposible, y con el que la hija de la tabernera, Inocencia, siente a la vez por el joven Txomin. La tabernera, Eustasia, es una etxekoandre de su casa que mantiene la organización de la misma y del negocio. En contraste con la actitud de su marido, ve la oportunidad, cuando Santi anuncia su boda, de emparentarse con el alcalde haciendo que su hija sea la novia, cosa que Inocencia no quiere al estar enamorada de Txomin."}]},{"passage_id":"Pef76a783b65ac162","segments":[{"t":"Ana Mari, sabedora de que José Miguel va a intentar abortar cualquier intento de matrimonio de su tío, se ofrece como esposa a este. Ambos son conscientes del sacrificio que esto implica, la juventud de Ana Mari, pero garantizando una vida cómoda y manteniendo la memoria del amor que Santi sintió por la madre de Ana Mari."}]}],"document_id":"D85cba47e72dca78e","license":"CC-BY-SA-4.0","revision":"165122991","url":"https://es.wikipedia.org/w/index.php?title=El_caserío&oldid=165122991","history_url":"https://es.wikipedia.org/w/index.php?title=El_caserío&action=history","retrieved_at":"2026-10-07T05:12:23Z"},"summary":null,"scores":[],"videos":[{"id":"XK9jypXVB0A","article_url":"https://es.wikipedia.org/wiki/El_caserío#Enlaces_externos","title":"EL CASERIO I","channel":"FERNANDO GARCIA","embeddable":true},{"id":"1U3-yFKO6_M","article_url":"https://es.wikipedia.org/wiki/El_caserío#Enlaces_externos","title":"Alfredo Kraus canta Zarzuela \"El Caserio\"","channel":"kraustrujillo","embeddable":true},{"id":"Go_5nLTSLyY","article_url":"https://es.wikipedia.org/wiki/El_caserío#Enlaces_externos","title":"El Caserío (Jesús Guridi) | Teatro de la Zarzuela","channel":"Teatro de la Zarzuela","embeddable":true}],"authored":[],"documents":[],"documents_total":0,"rism":[],"rism_total":0,"rism_url":null}