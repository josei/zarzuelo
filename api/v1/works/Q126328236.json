53e3","claim_b":"Ce8dab9be05ef6cb4","relation":"conflicts_with"},{"claim_a":"C25c3f235bd2a18d3","claim_b":"Ce8dab9be05ef6cb4","relation":"conflicts_with"},{"claim_a":"Cd99a52eeb5d2e7ae","claim_b":"Ce8dab9be05ef6cb4","relation":"conflicts_with"}],"n_claims":2}],"narratives":[{"id":"N2384dc26cd2017f5","type":"génesis","title":"Autor modifica el final de la obra","summary":"Con el final de la obra yo no estaba muy de acuerdo. Me refiero a la escena en que Juan José sale de la habitación de Rosa para matar a Paco y deja a Rosa encerrada bajo llave.","time":null,"status":"reported","evidence_ids":["P763464a5296d37ad"]},{"id":"N5140352da08e0bde","type":"anécdota","title":"Estreno de última hora en 1979","summary":"Se va a estrenar de chiripa, por carambola. El plan del Ministerio de Cultura era otro. Se había anunciado a bombo y platillo otro título, que no sé por qué no se ha estrenado… Y a última hora me pidieron Juan José.","time":"1979","status":"reported","evidence_ids":["P96209e1292a969f5"]},{"id":"N8109c1f56a07b48d","type":"recepción","title":"Previsión de que no sea exportable","summary":"Como no se trata de una ópera española, ‹‹de españolada más o menos de pandereta››, sino de un drama social madrileño sin folklorismo, me figuro que no será exportable.","time":null,"status":"reported","evidence_ids":["P56fdc44b5d4985da"]},{"id":"Nb3d84807d6c15557","type":"anécdota","title":"Pepita Jiménez: dos funciones y olvido","summary":"Estrenar una ópera en España era como celebrar en dos días el nacimiento y el entierro de una obra. Eso me pasó con la maravillosa ópera de nuestro primer músico, Isaac Albéniz, con su Pepita Jiménez.","time":null,"status":"reported","evidence_ids":["Pc0c3a06c55b08ce3"]},{"id":"Nb7b6ee3069d0958e","type":"génesis","title":"Dificultades de adaptación y ayuda de Aurora Dicenta","summary":"Todo esto me dio mucho trabajo y muy serias preocupaciones pude vencerlas porque el drama de Dicenta me entusiasmaba. También me ayudó mucho doña Aurora Dicenta, hija y heredera del famosos dramaturgo quien, cuando le leí el arreglo del primer acto me dio ánimos y todo generó facilidades.","time":null,"status":"reported","evidence_ids":["P3c7f7d7238ff0033"]},{"id":"Ncdf1bf585533b879","type":"génesis","title":"Dificultades del libreto basado en Dicenta","summary":"El confeccionar el libreto me ha costado muchísimo. Yo no sé escribir. Había que reducir el drama de Dicenta al mínimo quitando retórica, suprimiendo algún personaje y ampliando algunas escenas.","time":null,"status":"reported","evidence_ids":["P56fdc44b5d4985da"]}],"biography":{"paragraphs":[{"passage_id":"P327a199d0de1726f","segments":[{"t":"Juan José es un drama lírico popular en tres actos con música de "},{"t":"Pablo Sorozábal","to":"/persona/Q2206252"},{"t":" y libreto del mismo, basado en la obra de Joaquín Dicenta. Sorozábal terminó la obra en "},{"t":"1968","year":true},{"t":" y tuvo un intento de estreno en "},{"t":"1979","year":true},{"t":" que no resultó."}]},{"passage_id":"Pefe4e6e14ed08d92","segments":[{"t":"Finalmente, fue estrenada en el Teatro "},{"t":"Kursaal","to":"/teatro/Q2349872"},{"t":" de San Sebastián, en versión de concierto, el día 21 de febrero de "},{"t":"2009","year":true},{"t":". El 5 de febrero de "},{"t":"2016","year":true},{"t":", se estrenó en el "},{"t":"Teatro de la Zarzuela","to":"/teatro/Q3321632"},{"t":", tras 48 años, su versión escénica."}]},{"passage_id":"P54cc93a267d255d7","segments":[{"t":"La historia se desarrolla en los barrios bajos de Madrid. Juan José y Rosa viven desde hace tiempo juntos. Ella es para él el único sentido de su vida. Los acontecimientos que van surgiendo llevarán inevitablemente a un desenlace fatal."}]},{"passage_id":"Pfde245bfa3f1a1ba","segments":[{"t":"La escena se desarrolla en el interior de una taberna, situada en los barrios bajos de Madrid, durante el anochecer. La disposición del lugar revela su carácter, con un mostrador, taburetes, cortinillas y estanterías de madera. A la derecha, una puerta conduce a un reservado. Cuatro clientes disfrutan de bebidas y juegan a las cartas, mientras Andrés y Perico observan el juego en primer plano. Perico, con dificultad evidente, lee en voz alta un periódico. Después de discutir las noticias, la conversación gira hacia Juan José, un antiguo cliente de la taberna. Los presentes recuerdan cómo Juan José conoció a Rosa, defendiéndola de unos señoritos borrachos, y ahora viven juntos. Comentan que Juan José está pasando por momentos difíciles."}]},{"passage_id":"P2d9b0b4e7f4d6f1c","segments":[{"t":"Entra Juan José, cansado después de trabajar como peón, quejándose de no encontrar a Rosa esperándolo. Explica que ella es el único sentido de su vida y le ha dado cariño, algo que nunca había experimentado antes. Juan José sale acompañado por Andrés, y entra Isidra, una mujer mayor a la que todos toman a broma y consideran una alcahueta. Parece tener influencia sobre Rosa. En ese momento, un grupo de amigos, liderados por Paco, entra en la taberna con algarabía. Paco se acerca a Isidra, la invita a beber y hablan de Rosa y del interés de Paco en ella. Con una generosa propina, Paco asegura la ayuda de Isidra y ordena que les sirvan una cena en el reservado."}]},{"passage_id":"Pd486fb8498f36e58","segments":[{"t":"Rosa y Toñuela, despedidas de su trabajo, entran en escena. La tristeza de Rosa contrasta con la alegría de su amiga. Isidra aprovecha para culpar a Juan José de la situación y presenta a Paco como la salvación para Rosa. Se escuchan a lo lejos alegres coplas, cantadas por Paco y sus amigos en el reservado. Paco sale y elogia a Rosa, persuadiéndola para que se una a ellos y cante. Juan José regresa a la taberna, reconoce la voz de Rosa y la hace salir. Se enfrenta violentamente a Paco, revelando que este último es su capataz. Andrés sujeta a Juan José mientras otros clientes hacen lo mismo con Paco, evitando una confrontación física. Juan José ordena a Rosa que se vaya sola a casa y desafía a Paco desde la puerta, sostenido por Andrés, retándolo a seguirla."}]}],"document_id":"D737e22ce47274584","license":"CC-BY-SA-4.0","revision":"156195918","url":"https://es.wikipedia.org/w/index.php?title=Juan_José_(Sorozábal)&oldid=156195918","history_url":"https://es.wikipedia.org/w/index.php?title=Juan_José_(Sorozábal)&action=history","retrieved_at":"2026-10-06T21:15:06Z"},"summary":{"segments":[{"text":"Juan José es un drama lírico popular de tres actos con música y libreto de Pablo Sorozábal, basado en la obra de Joaquín Dicenta.","parts":[{"t":"Juan José es un drama lírico popular de tres actos con música y libreto de "},{"t":"Pablo Sorozábal","to":"/persona/Q2206252"},{"t":", basado en la obra de Joaquín Dicenta."}],"evidence_ids":["P327a199d0de1726f","P4202b98688f3368f"]},{"text":"La historia se sitúa en los barrios bajos de Madrid y narra la relación entre Juan José y Rosa, cuyo desenlace fatal está predestinado.","parts":[{"t":"La historia se sitúa en los barrios bajos de Madrid y narra la relación entre Juan José y Rosa, cuyo desenlace fatal está predestinado."}],"evidence_ids":["P54cc93a267d255d7"]},{"text":"La obra fue terminada en 1968, aunque su estreno escénico en el Teatro de la Zarzuela llegó a los 48 años de su finalización.","parts":[{"t":"La obra fue terminada en "},{"t":"1968","year":true},{"t":", aunque su estreno escénico en el "},{"t":"Teatro de la Zarzuela","to":"/teatro/Q3321632"},{"t":" llegó a los 48 años de su finalización."}],"evidence_ids":["P327a199d0de1726f","Pefe4e6e14ed08d92"]}],"model":"bartowski/Qwen_Qwen3.5-4B-GGUF:Q5_K_M","generated_at":"2026-10-08T11:35:37Z","verified":true},"scores":[],"videos":[],"documents":[],"documents_total":0,"rism":[],"rism_total":0,"rism_url":null}