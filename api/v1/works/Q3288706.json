erty":"premiere_date","value":"1936-04-06","value_label":null,"value_link":null,"value_type":"edtf","status":"disputed","hedge":null,"confidence":0.7,"source_kind":"structured","evidence_ids":["Pe01f8a0da8d65e4d"],"relations":[{"claim_a":"C20de919ddb8516f4","claim_b":"C5332978efec68289","relation":"refines"},{"claim_a":"C2f9893e668771f31","claim_b":"C5332978efec68289","relation":"refines"},{"claim_a":"C5332978efec68289","claim_b":"C59ffdf9cbd049471","relation":"refines"},{"claim_a":"C5332978efec68289","claim_b":"Ce624d3ad9a7eb185","relation":"refines"},{"claim_a":"C5332978efec68289","claim_b":"Cfa85b9537fa56bad","relation":"refines"}],"n_claims":1}],"narratives":[{"id":"N1aa1b577df90882d","type":"génesis","title":"Libreto rechazado por Ourdid, pasa a Sorozabal","summary":"Al finalizarlo, tanto Fernández-Shaw como Federico Romero le propusieron el libreto a Ourdid el cual lo rechazo por lo que se lo ofrecieron a Sorozabal.","time":null,"status":"documented","evidence_ids":["P62014403a7e18c1e"]},{"id":"N79f573c6eca8416e","type":"recepción","title":"Estreno y acogida en Barcelona, 1936","summary":"La obra se estrenó el 6 de mayo de 1936 a las 22:00 en el Teatro Tívoli de Barcelona con una gran acogida tanto de crítica como de público pese a la cantidad de oferta cultural existente en la ciudad condal ese mismo día","time":"1936-05-06","status":"documented","evidence_ids":["P90d672edb260919e"]},{"id":"Ne8003afe265935e4","type":"recepción","title":"Boicot de Falange en el estreno madrileño","summary":"Pese a ello asistió al estreno en el cual un comité de Falange, apoyado por el compositor Federico Moreno Torroba y el crítico Víctor Ruiz Albéniz realizó un boicot a la representación.","time":"1940","status":"documented","evidence_ids":["P6a95d6a3113af91a"]},{"id":"Nf17e6d4afafb768b","type":"recepción","title":"Crítica destructiva bajo seudónimo","summary":"Bajo el pseudónimo Acorde Ruiz Albéniz dedicó una crítica destructiva en la que atacaba a los libretistas y al compositor. Pese a ello la obra fue muy bien acogida y un éxito total.","time":null,"status":"documented","evidence_ids":["P6a95d6a3113af91a"]}],"biography":{"paragraphs":[{"passage_id":"P6e192d4f195345e6","segments":[{"t":"La tabernera del puerto es una zarzuela en 3 actos con música de "},{"t":"Pablo Sorozábal","to":"/persona/Q2206252"},{"t":" y libreto de "},{"t":"Federico Romero Sarachaga","to":"/persona/Q2071594"},{"t":" y "},{"t":"Guillermo Fernández-Shaw Iturralde","to":"/persona/Q4888937"},{"t":". Fue estrenada el 6 de mayo de "},{"t":"1936","year":true},{"t":" en el "},{"t":"Teatro Tívoli","to":"/teatro/Q5101816"},{"t":" de Barcelona."}]},{"passage_id":"P57ca3b6d56ddb54d","segments":[{"t":"La idea original del libreto, según los libretistas, vino de un poema publicado el 3 de febrero de "},{"t":"1935","year":true},{"t":" en el ABC por el propio "},{"t":"Federico Romero","to":"/persona/Q2071594"},{"t":" y que decía así:"}]},{"passage_id":"P62014403a7e18c1e","segments":[{"t":"El libreto se escribió en romance que sumado al ambiente de ensoñación de la obra creaba una atmósfera de fábula. Al finalizarlo, tanto Fernández-Shaw como "},{"t":"Federico Romero","to":"/persona/Q2071594"},{"t":" le propusieron el libreto a Ourdid el cual lo rechazo por lo que se lo ofrecieron a Sorozabal. Este se encontraba en la cima de su carrera habiendo sido nombrado director de la Banda Municipal de Madrid y la Orquesta Sinfónica de Madrid El autor donostiarra tenía una trayectoria escénica muy variada con obras vanguardistas influidas por la opereta contemporánea como "},{"t":"Katiuska, la mujer rusa","to":"/obra/Q5958636"},{"t":" ("},{"t":"1931","year":true},{"t":") o sainetes madrileños como "},{"t":"La del manojo de rosas","to":"/obra/Q5966465"},{"t":"."}]},{"passage_id":"P1ce84857b0b65514","segments":[{"t":"La acción se desarrolla en el puerto de la ciudad imaginaria de Cantabreda, en el norte de España, en fecha contemporánea al estreno ("},{"t":"1936","year":true},{"t":")."}]},{"passage_id":"Pca57eb439b3d36af","segments":[{"t":"En el puerto se encuentra la taberna de Marola. Nadie sabe el origen de Marola, solamente se conoce que la taberna fue costeada por el bandido Juan de Eguía, al que todos creen su marido."}]},{"passage_id":"P4e631c5de7d92751","segments":[{"t":"El marinero Simpson habla de Leandro (un pescador enamorado de Marola). Marola y Leandro se enamoran. Abel, un adolescente intérprete del acordeón, también se enamora de Marola pero no es correspondido."}]},{"passage_id":"P5bfe56a65780f661","segments":[{"t":"Un grupo de mujeres del pueblo reprochan a Marola que vuelve locos a todos los hombres, pero ella se defiende recriminándoles que no prestan atención a sus esposos. Juan de Eguía golpea a Marola ante la impotencia de Abel."}]},{"passage_id":"P6e816bc462a81a2f","segments":[{"t":"Al día siguiente Abel cuenta lo sucedido, lo que hace que todos los presentes busquen a Juan para pedirle explicaciones. Leandro conversa con Marola, quien confiesa que Juan de Eguía es su padre, ante lo cual Leandro convence a su amada para que huya con él."}]},{"passage_id":"P1d4d5809aa9f4cb2","segments":[{"t":"Juan de Eguía aparece de nuevo y le promete a Leandro la mano de Marola a cambio de que introduzca un fardo de cocaína en la ciudad. Leandro acepta y acompañado de su amada se dirigen en una pequeña embarcación hacia una cueva que solo tiene acceso por mar, para cargar el fardo de cocaína, pero son sorprendidos por una tormenta y desaparecen."}]},{"passage_id":"P134ccf031fd3d77e","segments":[{"t":"Abel canta a la desaparecida Marola, mientras Juan entristecido les cuenta a todos los presentes que ella es en realidad su hija. Poco después el marinero Simpson trae la buena noticia de que Leandro y Marola están vivos y se dirigen al puerto detenidos por los carabineros. Juan confiesa ser el verdadero culpable de todo lo sucedido y es detenido, mientras que Leandro y Marola quedan en libertad."}]}],"document_id":"D3d7ecc74194dee37","license":"CC-BY-SA-4.0","revision":"175050509","url":"https://es.wikipedia.org/w/index.php?title=La_tabernera_del_puerto&oldid=175050509","history_url":"https://es.wikipedia.org/w/index.php?title=La_tabernera_del_puerto&action=history","retrieved_at":"2026-10-06T21:05:23Z"},"summary":null,"scores":[],"videos":[{"id":"mRFVLQj6_Uw","article_url":"https://es.wikipedia.org/wiki/La_tabernera_del_puerto#Enlaces_externos","title":"[Conferencia] La tabernera del puerto I Teatro de la Zarzuela","channel":"Teatro de la Zarzuela","embeddable":true}],"documents":[],"documents_total":0,"rism":[],"rism_total":0,"rism_url":null}