,"hedge":null,"confidence":0.5,"source_kind":"extracted","evidence_ids":["P30dc55d43256fb32"],"relations":[{"claim_a":"C16567ea9e776a58f","claim_b":"Cc06951edc4572b67","relation":"supports"}],"n_claims":2}],"narratives":[{"id":"N0ce5cecbc434a512","type":"contexto_histórico","title":"Ambientación en Normandía para evitar la censura","summary":"Para evitar mayores problemas con la censura, los autores colocaron la acción en la Normandía, en Francia. La precaución resultó inútil, ya que el régimen cayó un mes antes del estreno de la obra.","time":null,"status":"documented","evidence_ids":["P525edb1b9e196f54"]},{"id":"Nc97cfa1cb74aa78e","type":"contexto_histórico","title":"Símbolos catalanes bajo la dictadura de Primo de Rivera","summary":"Destaca sobre todo por el uso de símbolos catalanes durante la dictadura de Primo de Rivera, como la sardana «Ja la cobla toca al lluny... Sardana nostra sona sempre.», que no eran bien vistas por el régimen","time":null,"status":"documented","evidence_ids":["P525edb1b9e196f54"]}],"biography":{"paragraphs":[{"passage_id":"P30dc55d43256fb32","segments":[{"t":"La Legió d'Honor (en español, «La Legión de Honor») es una zarzuela en catalán, en dos actos, estrenada en el "},{"t":"Teatre Nou","to":"/teatro/Q11951021"},{"t":" de Barcelona, el 26 de febrero de "},{"t":"1930","year":true},{"t":". La obra tiene libreto de Víctor Mora Alzinelles y "},{"t":"Lluís Capdevila Vilallonga","to":"/persona/Q11933583"},{"t":", y la música es del compositor valenciano "},{"t":"Rafael Martínez Valls","to":"/persona/Q11944435"},{"t":"."}]},{"passage_id":"P525edb1b9e196f54","segments":[{"t":"La obra ha sido aclamada como una de las más logradas de su compositor, Martínez Valls. Destaca sobre todo por el uso de símbolos catalanes durante la dictadura de Primo de Rivera, como la sardana «Ja la cobla toca al lluny... Sardana nostra sona sempre.», que no eran bien vistas por el régimen, aunque, como en el caso de "},{"t":"Cançó d'amor i de guerra","to":"/obra/Q8262475"},{"t":", a veces conseguían pasar la censura. Para evitar mayores problemas con la censura, los autores colocaron la acción en la Normandía, en Francia. La precaución resultó inútil, ya que el régimen cayó un mes antes del estreno de la obra."}]},{"passage_id":"Pffa8d48628891de6","segments":[{"t":"La trama reúne aventuras y amores, resultando compleja. Básicamente es la historia de amor entre Carlota, una bella normanda, y Marcel, un catalán que se ha apuntado a la Legión Extranjera francesa. Marcel, en sus cantos, recuerda los paisajes y la música de su Cataluña natal."}]},{"passage_id":"P6acb6fd6afb0752e","segments":[{"t":"Preludio y canción de Carlota con coro de jóvenes, «Déu et guard amiga nostra [...] de la tarda a la llum caient [...] Pagaseta normandesa»."}]},{"passage_id":"Pc40490af55300bed","segments":[{"t":"Coro, «Les Noies vanen somrient», Brindis, «Ompliu postres gots\" i cançó de Brissac \"Escolteu-me ... ..D'aquella flor muntanyesa»."}]},{"passage_id":"P01f94173cabc5f49","segments":[{"t":"Romanza de Carlota «Déu meu, Senyor!» y final «Tornarem Quan fini la guerra [...] És Orgull la Vostra bravesa»."}]},{"passage_id":"Pa9b10b40db263c7f","segments":[{"t":"Columbia, "},{"t":"1965","year":true},{"t":" - Directores, Rafael Ferrer con la Gran Orquesta Sinfónica y Antoni Pérez Simó con el Orfeó Gracienc y cantan Francesca Callao, Carme Rigolfas, Eduard Gimenez, Manuel Ausensi y Dídac Monjo."}]}],"document_id":"Ded876cd61cb4100d","license":"CC-BY-SA-4.0","revision":"175556918","url":"https://es.wikipedia.org/w/index.php?title=La_Legió_d'Honor&oldid=175556918","history_url":"https://es.wikipedia.org/w/index.php?title=La_Legió_d'Honor&action=history","retrieved_at":"2026-10-06T21:06:22Z"},"summary":null,"scores":[],"videos":[],"authored":[],"documents":[],"documents_total":0,"rism":[],"rism_total":0,"rism_url":null}