daa96a6dee","wikidata_rank":null,"references":[],"alternative":false,"source_families":["wikimedia"],"property":"librettist","value":"kb:96bb9bb0b5af","value_label":"Diego Luzuriaga","value_link":null,"value_type":"entity","status":"asserted","hedge":null,"confidence":0.5,"source_kind":"extracted","evidence_ids":["P068b0e2d3ca565d7"],"relations":[],"n_claims":1},{"id":"C67d71194bd45e023","wikidata_rank":null,"references":[],"alternative":false,"source_families":["wikimedia"],"property":"premiere_venue","value":"kb:ef6fa7fcde00","value_label":"Teatro Nacional Sucre","value_link":null,"value_type":"entity","status":"asserted","hedge":null,"confidence":0.5,"source_kind":"extracted","evidence_ids":["P068b0e2d3ca565d7"],"relations":[],"n_claims":2},{"id":"Ca2ce239b1e94f64f","wikidata_rank":"normal","references":["Q8449"],"alternative":false,"source_families":["wikimedia"],"property":"publication_date","value":"2006","value_label":null,"value_link":null,"value_type":"edtf","status":"asserted","hedge":null,"confidence":0.7,"source_kind":"structured","evidence_ids":["Pa693588d70f5c897"],"relations":[],"n_claims":1},{"id":"C910223647dd5ed1c","wikidata_rank":null,"references":[],"alternative":false,"source_families":["wikimedia"],"property":"premiere_date","value":"2006-11-13","value_label":null,"value_link":null,"value_type":"edtf","status":"asserted","hedge":null,"confidence":0.5,"source_kind":"extracted","evidence_ids":["P068b0e2d3ca565d7"],"relations":[],"n_claims":1}],"narratives":[],"biography":{"paragraphs":[{"passage_id":"P068b0e2d3ca565d7","segments":[{"t":"Manuela y Bolívar es una ópera con libreto y música del compositor ecuatoriano Diego Luzuriaga. La obra relata la relación amorosa entre Manuela Sáenz y Simón Bolívar. Se estrenó el 13 de noviembre de "},{"t":"2006","year":true},{"t":" en el Teatro Nacional Sucre en Quito, como creación artística de la Compañía Lírica Nacional con el acompañamiento de la Orquesta Sinfónica Nacional de Ecuador."}]},{"passage_id":"P9f611032867718bb","segments":[{"t":"El libreto inicia en los días previos a la Batalla de Pichincha del 24 de mayo de "},{"t":"1822","year":true},{"t":" y culmina con la muerte de Manuela Sáenz, conocida como La Libertadora del Libertador, en "},{"t":"1856","year":true},{"t":" en Paita. La obra tiene una forma bastante ecléctica y contiene pasajes recitados y números musicales de factura diversa, entre ellos se encuentran números de corte operístico moderno; de carácter más popular cercano a la zarzuela; y también formas propias de la cantata."}]},{"passage_id":"P1fa728c7a941cb84","segments":[{"t":"La obra, que tiene una duración de dos horas, hace referencia a ritmos latinoamericanos como un aire típico ecuatoriano, una zamacueca peruana o un merengue venezolano. Se trata de un estilo musical que conjuga lo romántico y lo heroico."}]},{"passage_id":"P2f8d56bcefafbb10","segments":[{"t":"Diccionario de la música española e hispanoamericana (DMEH). Editado por la Sociedad General de Autores y Editores (SGAE) y el Instituto Nacional de las Artes Escénicas y de la Música (INAEM) del Ministerio de Educación, Cultura y Deporte de España."}]}],"document_id":"D3ba22b0eeee68d26","license":"CC-BY-SA-4.0","revision":"174392791","url":"https://es.wikipedia.org/w/index.php?title=Manuela_y_Bolívar&oldid=174392791","history_url":"https://es.wikipedia.org/w/index.php?title=Manuela_y_Bolívar&action=history","retrieved_at":"2026-10-07T05:09:30Z"},"summary":null,"scores":[],"videos":[{"id":"x5b-ex7Tn8A","article_url":"https://es.wikipedia.org/wiki/Manuela_y_Bolívar#Enlaces_externos","title":"Javier Andrade Córdova - ópera Manuela y Bolívar","channel":"Javier Andrade Córdova","embeddable":true}],"documents":[],"documents_total":0,"rism":[],"rism_total":0,"rism_url":null}