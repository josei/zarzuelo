amilies":["wikimedia"],"property":"librettist","value":"kb:1ee31db044fe","value_label":"Jacinto Capella","value_link":null,"value_type":"entity","status":"asserted","hedge":null,"confidence":0.5,"source_kind":"extracted","evidence_ids":["Pd48d4e77f05fd0e2"],"relations":[],"n_claims":2},{"id":"C4ed667d9e41caed4","wikidata_rank":null,"references":[],"alternative":false,"source_families":["wikimedia"],"property":"librettist","value":"Q5940688","value_label":"José Jackson Veyán","value_link":"persona","value_type":"entity","status":"asserted","hedge":null,"confidence":0.5,"source_kind":"extracted","evidence_ids":["Pd48d4e77f05fd0e2"],"relations":[],"n_claims":2},{"id":"C21bf1b4ddf46721d","wikidata_rank":null,"references":[],"alternative":false,"source_families":["wikimedia"],"property":"premiere_venue","value":"Q6139946","value_label":"Teatro de Capellanes","value_link":"teatro","value_type":"entity","status":"asserted","hedge":null,"confidence":0.5,"source_kind":"extracted","evidence_ids":["Pd48d4e77f05fd0e2"],"relations":[],"n_claims":2},{"id":"C36aeffc8636bdd05","wikidata_rank":"normal","references":["Q8449"],"alternative":false,"source_families":["wikimedia"],"property":"premiere_venue","value":"Q10931773","value_label":"Teatro Cómico","value_link":null,"value_type":"entity","status":"asserted","hedge":null,"confidence":0.7,"source_kind":"structured","evidence_ids":["P75abd819336703f4"],"relations":[],"n_claims":1},{"id":"C744ca22666595803","wikidata_rank":null,"references":[],"alternative":false,"source_families":["wikimedia"],"property":"premiere_date","value":"1905-12-23","value_label":null,"value_link":null,"value_type":"edtf","status":"asserted","hedge":null,"confidence":0.5,"source_kind":"extracted","evidence_ids":["Pd48d4e77f05fd0e2"],"relations":[{"claim_a":"C744ca22666595803","claim_b":"Cca6d7fb061d414fb","relation":"supports"}],"n_claims":2}],"narratives":[{"id":"N08b7837b99c0dcca","type":"contexto_histórico","title":"Relación con el vodevil francés","summary":"Esta es una obra cercana al género del vodevil francés, que empezaba a tomar auge a principios del siglo XX en España.","time":null,"status":"documented","evidence_ids":["Pa0d314802c485783"]}],"biography":{"paragraphs":[{"passage_id":"Pd48d4e77f05fd0e2","segments":[{"t":"La Gatita Blanca es una zarzuela, denominada Humorada Lírica, en un acto, dividido en tres cuadros, original de "},{"t":"José Jackson Veyán","to":"/persona/Q5940688"},{"t":" y Jacinto Capella, con música de "},{"t":"Amadeo Vives","to":"/persona/Q2648593"},{"t":" y "},{"t":"Jerónimo Jiménez","to":"/persona/Q1688024"},{"t":". Se estrenó con gran éxito en el "},{"t":"Teatro Cómico de Madrid","to":"/teatro/Q6139946"},{"t":", el 23 de diciembre de "},{"t":"1905","year":true},{"t":"."}]},{"passage_id":"Pa0d314802c485783","segments":[{"t":"Esta es una obra cercana al género del vodevil francés, que empezaba a tomar auge a principios del siglo XX en España. Aunque pesa esta influencia, la trama es tratada con los medios tradicionales del sainete, contraponiendo los personajes rurales con los urbanos, logrando grandes momentos de comicidad, a la par que está dosificada con ciertos toques picantes, que lo hacen cercano al género \"sicalíptico\", que empezaba a estar de boga por aquellos años."}]},{"passage_id":"P24449290c8a9c005","segments":[{"t":"Con respecto a la música, la partitura, pese a lo ligera que puede parecer, es una obra de gran trabajo orquestal y melódico, ya que tanto "},{"t":"Amadeo Vives","to":"/persona/Q2648593"},{"t":" como "},{"t":"Jerónimo Jiménez","to":"/persona/Q1688024"},{"t":" eran autores con profundos conocimientos musicales y técnicos, que le dieron a la partitura el carácter necesario, siguiendo la línea frívola que empezaba a instaurarse en España, proveniente de Francia. En algunos momentos podemos encontrar ese sabor offenbachiano del cancán o de las operetas francesas del momento."}]},{"passage_id":"P701a36384b18a804","segments":[{"t":"En un salón reservado de un restaurante, Manolo celebra su despedida de soltero, puesto que se va a casar con una prima suya, la cual es rica pero a la que no quiere. Amenizan la cena varias cupletistas y amigas. Aparece en el restaurante Luisa, cupletista conocida como la Gatita Blanca, a saludar a Manolo, el cual le marca una distancia y le comenta que esta boda es necesaria para poder saldar sus deudas, a lo que Luisa le contesta agriamente que también ella necesitaría casarse con un viejo con posibles, para poder saldar las suyas, ya que ella está enterada por ciertas amistades que la futura esposa de Manolo es una chica rica, pero algo palurda."}]},{"passage_id":"P89557ad10e416ccb","segments":[{"t":"Al restaurante aparece el futuro suegro, Don Servando, el cual es un millonario algo palurdo, dando Manolo la espantada; Luisa se encarga de recibirlo. Este viene acompañado de su sobrino Periquín, el cual está enamorado en secreto de Rosario, la futura esposa de Manolo. Tras la conversación hacen un trato Luisa y Servando: ella se ocupará de darle lecciones de urbanidad y comportamiento social a Rosario."}]},{"passage_id":"Pae8047212caae5bc","segments":[{"t":"En la casa de huéspedes donde residen don Servando y doña Virtudes, con su hija Rosario, Manolo trata de conquistarla, pero la muchacha reacciona a todo con mucha sosería que incomoda a su madre. Al marcharse Manolo, llega Luisa, disfrazada como una exuberante institutriz, para preparar la lección de Rosario. Doña Virtudes ve con malos ojos esta clase de lecciones. Asiste a ella toda la familia, la cual se divierte con ello, e incluso hace que doña Virtudes pierda algo de seriedad. En un aparte, Luisa, que venía con planes de desbaratar la boda, descubre que Rosario y Periquín se quieren en secreto, por lo que decide ayudarles, invitándo a todos a un baile de máscaras que se celebrará esa misma noche."}]}],"document_id":"D91bfe4715a0972c1","license":"CC-BY-SA-4.0","revision":"162841244","url":"https://es.wikipedia.org/w/index.php?title=La_gatita_blanca&oldid=162841244","history_url":"https://es.wikipedia.org/w/index.php?title=La_gatita_blanca&action=history","retrieved_at":"2026-10-07T05:12:09Z"},"summary":null,"scores":[],"videos":[],"documents":[],"documents_total":0,"rism":[],"rism_total":0,"rism_url":null}