aim_a":"C591e07a013a938fa","claim_b":"Cc3cc24179e23ac68","relation":"supports"},{"claim_a":"C591e07a013a938fa","claim_b":"Cd69c906c14acf05f","relation":"conflicts_with"},{"claim_a":"C1f602517b326e460","claim_b":"Cc3cc24179e23ac68","relation":"refines"},{"claim_a":"C69754131fd545b1f","claim_b":"Cc3cc24179e23ac68","relation":"refines"},{"claim_a":"Cc3cc24179e23ac68","claim_b":"Cd69c906c14acf05f","relation":"conflicts_with"}],"n_claims":5},{"id":"Cd69c906c14acf05f","wikidata_rank":null,"references":[],"alternative":true,"source_families":["wikimedia"],"property":"premiere_date","value":"2005-04","value_label":null,"value_link":null,"value_type":"edtf","status":"disputed","hedge":null,"confidence":0.3,"source_kind":"extracted","evidence_ids":["P06193b675557db2c"],"relations":[{"claim_a":"C1f602517b326e460","claim_b":"Cd69c906c14acf05f","relation":"conflicts_with"},{"claim_a":"C3e0be4df7be038d7","claim_b":"Cd69c906c14acf05f","relation":"conflicts_with"},{"claim_a":"C591e07a013a938fa","claim_b":"Cd69c906c14acf05f","relation":"conflicts_with"},{"claim_a":"C69754131fd545b1f","claim_b":"Cd69c906c14acf05f","relation":"conflicts_with"},{"claim_a":"Cc3cc24179e23ac68","claim_b":"Cd69c906c14acf05f","relation":"conflicts_with"}],"n_claims":1}],"narratives":[{"id":"N659ea42a4dd0b44f","type":"leyenda","title":"Maldición de Amapola y el beso prohibido","summary":"Cuando va a besarla, aparece Ulita, la hechicera del campamento y lo impide; ella relata que la madre de Amapola, tras entregar su amor a un mal hombre, cuyo fruto fue Amapola, antes de morir lanzó una maldición a su hija, todo aquel que trate de besarla morirá sin remedio.","time":null,"status":"legendary","evidence_ids":["P46a62c8fa951ff70"]},{"id":"N7b6b64323c037064","type":"curiosidad","title":"Intermedio con nueva letra y Mocedades","summary":"al que en 1982 puso nueva letra Luis Gómez-Escolar y que interpretó el grupo Mocedades en el tema «Amor de hombre»","time":"1982","status":"documented","evidence_ids":["P543bb5e72217f6f3"]},{"id":"N8d53987b8eb38a7b","type":"recepción","title":"Estreno colombiano en Medellín, 2005","summary":"En Colombia, se presentó por primera vez en el Teatro Metropolitano de la ciudad de Medellín, con motivo de la XI Temporada Internacional de Ópera, Opereta y Zarzuela (abril del 2005)","time":"2005-04","status":"documented","evidence_ids":["P06193b675557db2c"]},{"id":"N932d33162eff221f","type":"recepción","title":"Obra que lanza a Soutullo y Vert","summary":"Esta zarzuela es considerada la obra que lleva a la fama a los maestros Soutullo y Vert.","time":null,"status":"documented","evidence_ids":["Pb60b1ec527de495a"]}],"biography":{"paragraphs":[{"passage_id":"Pbb1e31c5bf3c3c75","segments":[{"t":"La leyenda del beso es una zarzuela en dos actos, dividida en tres cuadros. Con libreto de "},{"t":"Enrique Reoyo","to":"/persona/Q20203555"},{"t":", "},{"t":"José Silva Aramburu","to":"/persona/Q52158616"},{"t":" y "},{"t":"Antonio Paso","to":"/persona/Q5699310"},{"t":", y música de los maestros "},{"t":"Reveriano Soutullo","to":"/persona/Q958570"},{"t":" y "},{"t":"Juan Vert","to":"/persona/Q2744002"},{"t":". Se estrenó con gran éxito en el teatro Apolo, de Madrid, el viernes 18 de enero de "},{"t":"1924","year":true},{"t":"."}]},{"passage_id":"Pb60b1ec527de495a","segments":[{"t":"Esta zarzuela es considerada la obra que lleva a la fama a los maestros Soutullo y Vert. El libreto es un exponente de la zarzuela llevada al campo de la opereta, con ciertos toques melodramáticos, a la par que ciertos elementos exóticos para dar color."}]},{"passage_id":"P543bb5e72217f6f3","segments":[{"t":"A la música, indudablemente de gran calidad y vuelo lírico, se la puede considerar como una ópera en sí, dado el tratamiento tan profundo de las voces y la riqueza orquestal, raramente contempladas en la zarzuela, hasta la llegada de autores como Sorozábal, Guridi, o Usandizaga, necesitando siempre de buenos cantantes y músicos. De esta obra se puede destacar algunos números como La Canción de Iván Brilla Cuchillo, la Zambra o el celebérrimo Intermedio, al que en "},{"t":"1982","year":true},{"t":" puso nueva letra Luis Gómez-Escolar y que interpretó el grupo Mocedades en el tema «Amor de hombre»"}]},{"passage_id":"P53ccebfb70e6b4c3","segments":[{"t":"En el parque de un viejo castillo señorial, Mario y sus amigos celebran su despedida de soltero, debido a su boda con una señorita impuesta por su familia. A ella acuden todos sus amigos y amigas, destaca entre ellos Gorón, un calavera simpático y fresco, dispuesto a todo; en concreto, a seducir a la hija del guardia del castillo, Simeona, sin preocuparse mucho de Cristóbal, el novio de esta, un bruto gañán. Juan, el guardia, interrumpe la fiesta avisando de la llegada de unos gitanos que piden permiso para acampar en las tierras del castillo, los hacen pasar y se presentan ante Mario y sus amigos."}]},{"passage_id":"Pc709586d8cc810ba","segments":[{"t":"Mario queda sorprendido por la belleza de Amapola, la reina de los gitanos. Alesko, su jefe, cuenta que hace muchos años pasaron por estas tierras y aquí murió la madre de Amapola, siendo para ellos estas tierras sagradas; piden su permiso para acampar. Mario accede y pide a los gitanos que preparen una pequeña fiesta para agasajar a sus invitados. Mario trata de seducir con sus palabras a Amapola, sucumbiendo ante estas. Entra Iván, el prometido de Amapola, con un evidente ataque de celos al descubrir la escena, produciéndose una ágria discusión."}]},{"passage_id":"P7eb2ac9397df7f15","segments":[{"t":"Cristóbal regaña a Simeona por su actitud con Gorón, recalcándole que si trata de acercarse a ella, le dará un buen escarmiento. Gorón aprovecha para poner en práctica sus dotes seductoras con Simeona, logrando su propósito; cuando está a punto de besarla aparece Cristóbal y lo espanta."}]}],"document_id":"D75b32633135af3ac","license":"CC-BY-SA-4.0","revision":"165625408","url":"https://es.wikipedia.org/w/index.php?title=La_leyenda_del_beso&oldid=165625408","history_url":"https://es.wikipedia.org/w/index.php?title=La_leyenda_del_beso&action=history","retrieved_at":"2026-10-07T05:06:14Z"},"summary":null,"scores":[],"videos":[],"authored":[],"documents":[],"documents_total":0,"rism":[],"rism_total":0,"rism_url":null}