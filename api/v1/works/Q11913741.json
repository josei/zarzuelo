e ponen alegres y hay un final feliz."}]}],"document_id":"D8751d0c715523800","license":"CC-BY-SA-4.0","revision":"172463813","url":"https://es.wikipedia.org/w/index.php?title=Chateau_Margaux_(zarzuela)&oldid=172463813","history_url":"https://es.wikipedia.org/w/index.php?title=Chateau_Margaux_(zarzuela)&action=history","retrieved_at":"2026-10-06T21:06:24Z"},"summary":null,"scores":[{"source":"IMSLP","page_url":"https://imslp.org/wiki/Ch%C3%A2teau-Margaux_(Fern%C3%A1ndez_Caballero,_Manuel)","license":"CC-BY-SA-4.0 (texto de la wiki); cada fichero declara su propio copyright","files":[{"name":"PMLP985608-CHATEAU-MARGAUX_1.pdf","desc":"1. Preludio","edition":"CHATEAU · Conservatorio \"Tomás Bote Lavado\", 2021.","copyright":"Creative Commons Attribution-ShareAlike 4.0","publisher":"","editor":"","image_type":"Typeset","url":"https://imslp.org/wiki/File:PMLP985608-CHATEAU-MARGAUX_1.pdf"},{"name":"PMLP985608-mas232518.pdf","desc":"Complete Score","edition":"— · ''Recreio dos Salões: Collecção de Valsa Brilhantes dos mais celebres compositores para Piano'' · , Rio de Janeiro, n.d.(ca.1886)","copyright":"Public Domain","publisher":"","editor":"","image_type":"Normal Scan","url":"https://imslp.org/wiki/File:PMLP985608-mas232518.pdf"}],"retrieved_at":"2026-10-15T14:49:35Z"}],"videos":[],"documents":[],"documents_total":0,"rism":[],"rism_total":0,"rism_url":null}