ence_ids":["Pd9941539ea2f963c"],"relations":[],"n_claims":1},{"id":"C3cdd58a270ccf272","wikidata_rank":"normal","references":["Q8449"],"alternative":false,"source_families":["wikimedia"],"property":"premiere_venue","value":"Q15640802","value_label":"Teatro del Circo","value_link":"teatro","value_type":"entity","status":"asserted","hedge":null,"confidence":0.7,"source_kind":"structured","evidence_ids":["P7321412a78a01ad1"],"relations":[],"n_claims":1},{"id":"Cc8b3f7a632388e72","wikidata_rank":null,"references":[],"alternative":false,"source_families":["wikimedia"],"property":"premiere_venue","value":"kb:81934984abbc","value_label":"Teatro del Circo de Madrid","value_link":null,"value_type":"entity","status":"asserted","hedge":null,"confidence":0.5,"source_kind":"extracted","evidence_ids":["Pd9941539ea2f963c"],"relations":[],"n_claims":1},{"id":"C027c261f6e8dc57b","wikidata_rank":null,"references":[],"alternative":false,"source_families":["imslp","wikimedia"],"property":"premiere_date","value":"1870-03-18","value_label":null,"value_link":null,"value_type":"edtf","status":"asserted","hedge":null,"confidence":0.85,"source_kind":"structured","evidence_ids":["Pd9941539ea2f963c","Pe84cb5898cf8716e","P92233b5f75661e0a"],"relations":[{"claim_a":"C027c261f6e8dc57b","claim_b":"C1aaba19dc2b3a978","relation":"supports"},{"claim_a":"C027c261f6e8dc57b","claim_b":"Cb0c3830391e430ce","relation":"supports"},{"claim_a":"C027c261f6e8dc57b","claim_b":"Cd44e2dbca40e7c3f","relation":"supports"},{"claim_a":"C1aaba19dc2b3a978","claim_b":"Cb0c3830391e430ce","relation":"supports"},{"claim_a":"C1aaba19dc2b3a978","claim_b":"Cd44e2dbca40e7c3f","relation":"supports"},{"claim_a":"Cb0c3830391e430ce","claim_b":"Cd44e2dbca40e7c3f","relation":"supports"}],"n_claims":4}],"narratives":[{"id":"N0fb2b9643e7294db","type":"curiosidad","title":"Capitán Tiburón habla en acento catalán o andaluz","summary":"hasta las situaciones tan paradójicas como que uno de los principales personajes de la obra el Capitán Tiburón tenga que hablar, según se señala en el libreto, en acento catalán o andaluz.","time":null,"status":"documented","evidence_ids":["P09bee8e19a4c5607"]},{"id":"N3dbd11935dd6420f","type":"recepción","title":"Crítica favorable a la música, no al texto","summary":"Toda la prensa del momento coincidía en que el valor de la música era muy superior al del texto, en general criticado.","time":null,"status":"documented","evidence_ids":["Peeff56cd68260484"]},{"id":"N5fdbad7c6693a7e8","type":"génesis","title":"Barbieri acepta la propuesta del empresario","summary":"Barbieri respondió afirmativamente a la propuesta del empresario, porque en último término había en su espíritu una proximidad natural a varios aspectos de cuanto significaba el fenómeno bufo, y se acomoda en Robinson a un género en el que se busca conscientemente divertir, producir hilaridad, sin otras funciones.","time":null,"status":"documented","evidence_ids":["P50e6cc7ebf314d91"]},{"id":"N7d95f8b4abbba968","type":"génesis","title":"Composición apresurada antes del estreno","summary":"Barbieri compuso la obra en poco tiempo terminándola tres días antes del estreno. Ello no impidió su enorme éxito reconocido en todas la prensa del momento.","time":null,"status":"documented","evidence_ids":["P2bf0884afbc96f36"]},{"id":"Nb219f87033184287","type":"recepción","title":"Malestar por el retraso del estreno","summary":"En el periódico La correspondencia de España del 16 de marzo de 1870 podemos encontrar el malestar que se originó con el estreno de la obra, puesto que Barbieri retraso el día del estreno por, cito textualmente, atender a la dirección del Teatro Real.","time":"1870-03-16","status":"reported","evidence_ids":["Pe84cb5898cf8716e"]},{"id":"Ndbee24fe056a66c8","type":"recepción","title":"Acogida de Robinson en La España musical","summary":"Acaba de darse una zarzuela….titulada Robinson Crusoe, la cual ha sido recibida con los mayores aplausos hasta el punto de tenerse que repetir algunas de sus piezas. El público quedó altamente satisfecho de esta composición, que por sí solo bastaría para enaltecer a su autor","time":null,"status":"reported","evidence_ids":["Pec99ce5d5fce6f67"]},{"id":"Ndcd7b4d837d236f5","type":"recepción","title":"Popularidad en grandes ciudades","summary":"La obra se hizo popular representándose en grandes ciudades como Barcelona, Sevilla, Málaga, Murcia, Zaragoza y Sevilla.","time":null,"status":"documented","evidence_ids":["P2bf0884afbc96f36"]}],"biography":{"paragraphs":[{"passage_id":"Pd9941539ea2f963c","segments":[{"t":"Robinson es una zarzuela en tres actos compuesta por "},{"t":"Francisco Asenjo Barbieri","to":"/persona/Q1236051"},{"t":" y libreto de Rafael García Santisteban. Se estrenó el 18 de marzo de "},{"t":"1870","year":true},{"t":" en el "},{"t":"Teatro del Circo","to":"/teatro/Q15640802"},{"t":" de Madrid (España). Corresponde al género de zarzuela grande con mentalidad bufa, parodiando el personaje de la novela de Daniel Defoe Robinson Crusoe."}]},{"passage_id":"P7e2ff0bff196f8ea","segments":[{"t":"Acto I. Casa de Robinson, en Liverpool. Robinson es un calavera acribillado a deudas, a quien una cohorte de prestamistas, acaudillados por Matatías, el usurero mayor, se dispone a embargar. Su mujer, Leona, vuelve al cabo de tres años de un extraño viaje de novios en el que su marido prefirió no participar. Ella está obsesionada con una sola idea, y es una mujer de armas tomar. Ante una perspectiva tan poco halagüeña, Robinson acepta la invitación de su amigo el capitán Tiburón y se embarca para California aprovechando la confusión de una noche de jarana. Pero su criado Casimiro, su esposa y su prestamista favorito, no están dispuestos a dejarle marchar solo, por diferentes motivos."}]},{"passage_id":"Pe201a0056276e77a","segments":[{"t":"Acto II. En una isla del Caribe Robinson se ha librado de un naufragio y vive a su aire rodeado de naturaleza y de un sirviente, Domingo, que cambia sospechosamente de color. Pero Domingo y su loro no son los únicos habitantes de ese paraíso y Robinson va a sufrir en sus propias carnes el asedio de unas damas voraces. La reina Ananás y su lugarteniente Guayaba no piensan dejar escapar tan suculentos ejemplares y disponen una ceremonia oficiada por los severos sacerdotes del cabildo. Y después de la ceremonia vendrá el banquete. A la hora del baile se presentan unos viejos conocidos y su presencia no gusta nada a la ardiente reina Ananás, que monta en cólera y agarra su lanza."}]},{"passage_id":"P17d6e3ca1ecf8c28","segments":[{"t":"Acto III. En otra isla del Caribe. Una marcial tripulación deseosa de cambiar de aires forma a las órdenes del intrépido capitán Tiburón, que quiere devolver a su amigo a la salsa urbana y lo busca por toras partes con su habitual diplomacia. Los súbditos de la reina Leona no tienen el mismo ardor guerrero que sus contrincantes femeninos, y cuando Ananás se presenta en el campo de batalla para recuperar su botón se vislumbra una guerra desigual, si no fuera por la alegre marinería, que provoca una cierta conmoción entre los presentes. Decididamente la economía mueve el mundo. Aquí y en el Caribe. Y es que hoy día ni de náufrago puede uno vivir en paz."}]},{"passage_id":"P2bf0884afbc96f36","segments":[{"t":"Después de componer Pan y toros, Barbieri pasó por una especie de aúrea mediocritas de la que salió precisamente con algunos éxitos como el de Robinson. Esta obra pertenece al género de zarzuela grande y es concebida para los bufos de Arderíus, y por ello con una mentalidad de gran espectáculo y humor, como era típico en el género bufo. Barbieri compuso la obra en poco tiempo terminándola tres días antes del estreno. Ello no impidió su enorme éxito reconocido en todas la prensa del momento. La obra se hizo popular representándose en grandes ciudades como Barcelona, Sevilla, Málaga, Murcia, Zaragoza y Sevilla."}]}],"document_id":"D837c39ddcf9b49c8","license":"CC-BY-SA-4.0","revision":"174789917","url":"https://es.wikipedia.org/w/index.php?title=Robinson&oldid=174789917","history_url":"https://es.wikipedia.org/w/index.php?title=Robinson&action=history","retrieved_at":"2026-10-07T05:11:57Z"},"summary":null,"scores":[{"source":"IMSLP","page_url":"https://imslp.org/wiki/Robinson_(Barbieri,_Francisco_Asenjo)","license":"CC-BY-SA-4.0 (texto de la wiki); cada fichero declara su propio copyright","files":[{"name":"PMLP801684-Damas_T-Robinson_3.pdf","desc":"Núm. 3","edition":"Damas T · Madrid, n.d.[1873]","copyright":"Public Domain","publisher":"","editor":"","image_type":"Normal Scan","url":"https://imslp.org/wiki/File:PMLP801684-Damas_T-Robinson_3.pdf"},{"name":"PMLP801684-Damas_T-Robinson_5.pdf","desc":"Núm. 5","edition":"Damas T · Madrid, n.d.[1873]","copyright":"Public Domain","publisher":"","editor":"","image_type":"Normal Scan","url":"https://imslp.org/wiki/File:PMLP801684-Damas_T-Robinson_5.pdf"},{"name":"PMLP801684-Damas_T-Robinson_18.pdf","desc":"Núm. 18","edition":"Damas T · Madrid, n.d.[1873]","copyright":"Public Domain","publisher":"","editor":"","image_type":"Normal Scan","url":"https://imslp.org/wiki/File:PMLP801684-Damas_T-Robinson_18.pdf"},{"name":"PMLP801684-Fernandez_M-Robinson_Crusoe_1.pdf","desc":"Núm. 1","edition":"Fernandez M · Madrid, n.d.[1870]","copyright":"Public Domain","publisher":"","editor":"","image_type":"Normal Scan","url":"https://imslp.org/wiki/File:PMLP801684-Fernandez_M-Robinson_Crusoe_1.pdf"},{"name":"PMLP801684-Fernandez_M-Robinson_2.pdf","desc":"Núm. 2","edition":"Fernandez M · Madrid, n.d.[1870]","copyright":"Public Domain","publisher":"","editor":"","image_type":"Normal Scan","url":"https://imslp.org/wiki/File:PMLP801684-Fernandez_M-Robinson_2.pdf"},{"name":"PMLP801684-Fernandez_M-Robinson_3.pdf","desc":"Núm. 3","edition":"Fernandez M · Madrid, n.d.[1870]","copyright":"Public Domain","publisher":"","editor":"","image_type":"Normal Scan","url":"https://imslp.org/wiki/File:PMLP801684-Fernandez_M-Robinson_3.pdf"},{"name":"PMLP801684-Fernandez_M-Robinson_4.pdf","desc