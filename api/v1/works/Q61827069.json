ada","value_link":null,"value_type":"entity","status":"attributed","hedge":null,"confidence":0.35,"source_kind":"extracted","evidence_ids":["P90818570256b2511"],"relations":[],"n_claims":1},{"id":"Cfaa52013f9f0b903","wikidata_rank":null,"references":[],"alternative":false,"source_families":["wikimedia"],"property":"performer","value":"kb:e0650734277d","value_label":"Alicia Amo","value_link":null,"value_type":"entity","status":"asserted","hedge":null,"confidence":0.5,"source_kind":"extracted","evidence_ids":["Pce56c3ce30a0a54b"],"relations":[],"n_claims":1},{"id":"Ce15464a780b70288","wikidata_rank":null,"references":[],"alternative":false,"source_families":["wikimedia"],"property":"premiere_venue","value":"kb:e69ae633cf4e","value_label":"Auditorio Rafael Frübek de Burgos, España","value_link":null,"value_type":"entity","status":"asserted","hedge":null,"confidence":0.5,"source_kind":"extracted","evidence_ids":["P94d50ddd6ff4fe0c"],"relations":[],"n_claims":1},{"id":"Ce5f96a06ea7f9efa","wikidata_rank":null,"references":[],"alternative":false,"source_families":["wikimedia"],"property":"premiere_venue","value":"kb:59fd20f2a5db","value_label":"Auditorio Rafael Frübek de Burgos","value_link":null,"value_type":"entity","status":"asserted","hedge":null,"confidence":0.5,"source_kind":"extracted","evidence_ids":["P94d50ddd6ff4fe0c"],"relations":[],"n_claims":1},{"id":"C37ce9c9604482551","wikidata_rank":null,"references":[],"alternative":false,"source_families":["wikimedia"],"property":"premiere_date","value":"2017-11-12","value_label":null,"value_link":null,"value_type":"edtf","status":"asserted","hedge":null,"confidence":0.5,"source_kind":"extracted","evidence_ids":["P94d50ddd6ff4fe0c","P2d9bc3ac5841fa93"],"relations":[{"claim_a":"C37ce9c9604482551","claim_b":"Cac203551ad73658f","relation":"supports"}],"n_claims":2}],"narratives":[{"id":"N78380ca7da17dfe3","type":"génesis","title":"Completada por Alejandro Yagüe","summary":"En 1986 Alejandro Yagüe recibió el encargo de completar la obra, tarea que concluyó en 1992.","time":"1986","status":"documented","evidence_ids":["P67e33675bad6cebe"]},{"id":"N8f6c988b06a7b90d","type":"contexto_histórico","title":"Muerte del compositor interrumpe la obra","summary":"El encarcelamiento y fusilamiento del compositor en 1936 por el bando franquista impidió completar la obra.","time":"1936","status":"documented","evidence_ids":["P67e33675bad6cebe"]},{"id":"Nc5905b9e43dccc66","type":"curiosidad","title":"Tonada burgalesa con el mismo título","summary":"Se da la circunstancia de que en el folklore burgalés hay una tonada que comienza con ¿Dónde vas a dar agua, mozo de mulas?","time":null,"status":"documented","evidence_ids":["Pa866d1628dfcdebc"]},{"id":"Nd41fe08af53e6b22","type":"génesis","title":"Primera interpretación completa en 2017","summary":"El 12 de noviembre de 2017 se interpretó por primera vez de forma completa la obra. En este estreno participó la Orquesta Sinfónica de Burgos, dirigida por Javier Castro Villamor, el Coro de la Federación Coral de Burgos, dirigido por Juan Gabriel Martínez Marín, y la Rondalla de Profesores de Burgos.","time":"2017-11-12","status":"documented","evidence_ids":["P2d9bc3ac5841fa93"]},{"id":"Nf5820460157cec1a","type":"génesis","title":"Inicio de la composición en Málaga","summary":"Antonio José inició la composición de El mozo de mulas en 1927, durante su estancia en Málaga, donde fue maestro en el colegio San Estanislao del barrio de El Palo.","time":"1927","status":"documented","evidence_ids":["Pa866d1628dfcdebc"]}],"biography":{"paragraphs":[{"passage_id":"P94d50ddd6ff4fe0c","segments":[{"t":"El mozo de mulas es una ópera, una comedia lírica en tres actos compuesta por Antonio José Martínez Palacios, conocido como Antonio José, completada por Alejandro Yagüe Llorente sobre un libreto de Manuel Fernández Núñez y Lope Mateo. Tras diversas interpretaciones parciales, la primera del Preludio y la Danza Popular por la Orquesta Sinfónica de Madrid el 11 de noviembre de "},{"t":"1934","year":true},{"t":", fue estrenada, de forma completa en el Auditorio Rafael Frübek de Burgos, España, el 12 de noviembre de "},{"t":"2017","year":true},{"t":". No obstante, fue una interpretación en concierto, no una representación operística."}]},{"passage_id":"Pa866d1628dfcdebc","segments":[{"t":"Antonio José inició la composición de El mozo de mulas en "},{"t":"1927","year":true},{"t":", durante su estancia en Málaga, donde fue maestro en el colegio San Estanislao del barrio de El Palo. Se da la circunstancia de que en el folklore burgalés hay una tonada que comienza con ¿Dónde vas a dar agua, mozo de mulas? Si bien inicialmente el libreto era de cinco actos, finalmente se redujo a tres. A su regreso a Burgos, en "},{"t":"1929","year":true},{"t":", ya tenía completa la reducción a piano, mientras que la orquestación había sido parcialmente redactada. En "},{"t":"1930","year":true},{"t":" completó la orquestación del tercer acto. Sin embargo, a partir de ese año, debido a problemas personales y a otras actividades como la dirección del Orfeón Burgalés, el avance en los trabajos se ralentizó."}]},{"passage_id":"P26e0a3f460d28766","segments":[{"t":"El 11 de noviembre de "},{"t":"1934","year":true},{"t":" se estrenaron dos fragmentos, el Preludio y la Danza Popular del acto segundo en el Teatro Monumental de Madrid, con muy buena acogida por la crítica musical."}]},{"passage_id":"P67e33675bad6cebe","segments":[{"t":"El encarcelamiento y fusilamiento del compositor en "},{"t":"1936","year":true},{"t":" por el bando franquista impidió completar la obra. A la muerte del compositor, quedaba por realizar la orquestación de la segunda mitad del Segundo Acto. En "},{"t":"1986","year":true},{"t":" Alejandro Yagüe recibió el encargo de completar la obra, tarea que concluyó en "},{"t":"1992","year":true},{"t":"."}]},{"passage_id":"P2d9bc3ac5841fa93","segments":[{"t":"El 12 de noviembre de "},{"t":"2017","year":true},{"t":" se interpretó por primera vez de forma completa la obra. En este estreno participó la Orquesta Sinfónica de Burgos, dirigida por Javier Castro Villamor, el Coro de la Federación Coral de Burgos, dirigido por Juan Gabriel Martínez Marín, y la Rondalla de Profesores de Burgos. Este estreno en versión concierto fue organizado por el Instituto Municipal de Cultura del Ayuntamiento de Burgos, la Obra Social La Caixa y la Fundación Caja de Burgos. De su grabación en directo se editaron dos discos."}]},{"passage_id":"P238885fb7614ae0f","segments":[{"t":"(En la plaza de un pueblo de La Mancha, donde están las casas del Oídor y de don Álvaro. Entre el Preludio y la subida del telón, una rondalla toca un madrigal)."}]}],"document_id":"De9d803eeb46c527e","license":"CC-BY-SA-4.0","revision":"166325910","url":"https://es.wikipedia.org/w/index.php?title=El_mozo_de_mulas&oldid=166325910","history_url":"https://es.wikipedia.org/w/index.php?title=El_mozo_de_mulas&action=history","retrieved_at":"2026-10-07T05:08:56Z"},"summary":{"segments":[{"text":"El mozo de mulas es una ópera compuesta por Antonio José Martínez Palacios.","parts":[{"t":"El mozo de mulas es una ópera compuesta por Antonio José Martínez Palacios."}],"evidence_ids":["P94d50ddd6ff4fe0c"]},{"text":"El encarcelamiento y fusilamiento del compositor en 1936 por el bando franquista impidió completar la obra.","parts":[{"t":"El encarcelamiento y fusilamiento del compositor en "},{"t":"1936","year":true},{"t":" por el bando franquista impidió completar la obra."}],"evidence_ids":["P67e33675bad6cebe"]},{"text":"Alejandro Yagüe recibió el encargo de completar la obra en 1986, tarea que concluyó en 1992.","parts":[{"t":"Alejandro Yagüe recibió el encargo de completar la obra en "},{"t":"1986","year":true},{"t":", tarea que concluyó en "},{"t":"1992","year":true},{"t":"."}],"evidence_ids":["P67e33675bad6cebe"]}],"model":"bartowski/Qwen_Qwen3.5-4B-GGUF:Q5_K_M","generated_at":"2026-10-10T10:14:18Z","verified":true},"scores":[],"videos":[{"id":"_6v6C49xTUo","article_u