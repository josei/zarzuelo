im_a":"Cb65ca6bac00c7af3","claim_b":"Cbe2d10bde9e86283","relation":"supports"},{"claim_a":"Cb65ca6bac00c7af3","claim_b":"Cd0922b1714546b54","relation":"supports"},{"claim_a":"Cb65ca6bac00c7af3","claim_b":"Ceb52e15f2202cccd","relation":"supports"},{"claim_a":"Cbe2d10bde9e86283","claim_b":"Cd0922b1714546b54","relation":"supports"},{"claim_a":"Cbe2d10bde9e86283","claim_b":"Ceb52e15f2202cccd","relation":"supports"},{"claim_a":"Cd0922b1714546b54","claim_b":"Ceb52e15f2202cccd","relation":"supports"}],"n_claims":4}],"narratives":[{"id":"N00d6c84bfdf8cfb1","type":"contexto_histórico","title":"Recepción más fría en Barcelona","summary":"Con tal ocasión, la recepción fue considerablemente menos cálida que en Madrid. El movimiento nacionalista catalán estaba en auge como la Renaixença para revivir la cultura y el idioma catalanes. Parte del público se indignó con una ópera de compositor y libretista catalanes que se ambientaba fuera de Cataluña y que no incorporaba ni música ni temas catalanes.","time":"1899-05-31","status":"documented","evidence_ids":["Pfa5ad163a47b6d51"]},{"id":"N05c93335beb7b39e","type":"anécdota","title":"Contrato frustrado con Shilkret","summary":"En 1939 el hijo de Granados, Víctor, llevó la partitura original (junto con las partituras originales de otras tres obras de Granados) a Nathaniel Shilkret y firmó un contrato para la publicación de las mismas por Shilkret y el hijo de Shilkret, Arthur. Sin embargo, objeciones suscitadas por el resto de la familia Granados impidieron que las obras se publicasen.","time":"1939","status":"documented","evidence_ids":["Pb8b28faf08acd5f7"]},{"id":"N0b545a2c36751dd8","type":"recepción","title":"Sospecha de claque en el aplauso","summary":"Un crítico contemporáneo sugirió que el único aplauso procedía de una claque contratada para ello.","time":null,"status":"reported","evidence_ids":["P954fcc66a9bc164d"]},{"id":"N1bfe5097afe73309","type":"génesis","title":"Adaptación de la obra a ópera","summary":"Feliú i Codina, quien también había escrito el libreto para una zarzuela en un acto de Granados, Los Ovillejos, estuvo conforme en adaptar su obra para la ópera de Granados. El libreto resultante fue una versión considerablemente acortada de la versión original así como una simplificación de la trama.","time":null,"status":"documented","evidence_ids":["Pbfa0c66b820d80ae"]},{"id":"N5a424407fa08efba","type":"anécdota","title":"Comentario de un crítico tras el estreno","summary":"Un crítico del Diario de Barcelona recuerda que después de estreno de 1896 de la obra teatral de Feliú i Codina María del Carmen, oyó a otro crítico decir al autor \"Por amor de Dios, no permita que nadie ponga música a esto.\"","time":"1896","status":"reported","evidence_ids":["Pbfa0c66b820d80ae"]},{"id":"N6cc8a75b6e311dc5","type":"curiosidad","title":"Revisiones posteriores de la partitura","summary":"las únicas copias de la partitura disponibles en la época en que se escribía la biografía de Granados contenían probablemente revisiones posteriores del hijo de Granados, Eduardo.","time":null,"status":"reported","evidence_ids":["P894ab7807183ed65"]},{"id":"N72981d42babded3b","type":"recepción","title":"Olvido y reposición de 1935","summary":"Luego cayó en el olvido, aparte de una reposición en el año 1935 en el Liceo de Barcelona dirigida por Joan Lamote de Grignon con la famosa soprano Conchita Badía en el rol titular, y otras pocas representaciones más en España en los sesenta.","time":"1935","status":"documented","evidence_ids":["P954fcc66a9bc164d"]},{"id":"Nc8ce0b885c5cf5c9","type":"recepción","title":"Primera representación escenificada fuera de España","summary":"La producción que se estrenó el 23 de octubre de 2003 en el Theatre Royal, Wexford marcó la primera y (hasta ahora) única representación escenificada de María del Carmen fuera de España.","time":"2003-10-23","status":"documented","evidence_ids":["Pa5825c711bb40b4d"]},{"id":"Nd3a909fe7049186d","type":"anécdota","title":"Partitura salvada del naufragio del Sussex","summary":"Granados tenía el manuscrito original en su equipaje cuando se ahogó en el hundimiento de 1916 del Sussex por un U-boat alemán. Su equipaje, y la partitura de María del Carmen, se recuperaron posteriormente del naufragio.","time":"1916","status":"documented","evidence_ids":["Pb8b28faf08acd5f7"]},{"id":"Ne1bdf76b2f644ebd","type":"recepción","title":"Éxito del estreno en Madrid","summary":"María del Carmen se estrenó en el Teatro de Parish en Madrid el 12 de noviembre de 1898, dirigida por el compositor. Tuvo una acogida muy exitosa por parte del público y la mayoría de la crítica, y se representó hasta el 9 de enero de 1899.","time":"1898-11-12","status":"documented","evidence_ids":["Pfa5ad163a47b6d51"]}],"biography":{"paragraphs":[{"passage_id":"P91cfafaafde02732","segments":[{"t":"María del Carmen es una ópera en tres actos con música de "},{"t":"Enrique Granados","to":"/persona/Q294225"},{"t":" y libreto en español de "},{"t":"José Feliú y Codina","to":"/persona/Q2883060"},{"t":" basada en su obra homónima de "},{"t":"1896","year":true},{"t":". Se estrenó el 12 de noviembre de "},{"t":"1898","year":true},{"t":" en Madrid. Fue el primer éxito operístico de "},{"t":"Granados","to":"/persona/Q294225"},{"t":" y aunque está muy olvidada hoy en día, está considerada su mejor ópera. Al final de su temporada inicial en Madrid donde se estrenó en "},{"t":"1898","year":true},{"t":", la reina María Cristina premió a "},{"t":"Granados","to":"/persona/Q294225"},{"t":" con la Cruz de Carlos III en reconocimiento a su trabajo. La ópera, a veces descrita como una versión española de la Cavalleria rusticana de Mascagni con un final feliz, se ambienta en un pueblo de la región española de Murcia e implica un triángulo de amor entre María (soprano) y sus dos pretendientes, el campesino Pencho (barítono) y su adinerado rival, Javier (tenor)."}]},{"passage_id":"Pbfa0c66b820d80ae","segments":[{"t":"Un crítico del Diario de Barcelona recuerda que después de estreno de "},{"t":"1896","year":true},{"t":" de la obra teatral de Feliú i Codina María del Carmen, oyó a otro crítico decir al autor \"Por amor de Dios, no permita que nadie ponga música a esto.\" A pesar de todo, Feliú i Codina, quien también había escrito el libreto para una zarzuela en un acto de "},{"t":"Granados","to":"/persona/Q294225"},{"t":", Los Ovillejos, estuvo conforme en adaptar su obra para la ópera de "},{"t":"Granados","to":"/persona/Q294225"},{"t":". El libreto resultante fue una versión considerablemente acortada de la versión original así como una simplificación de la trama. Sin embargo, incluyó añadidos como una lujosa procesión pueblerina en el Acto 1 y un número de baile durante la fiesta en el Acto 2. "},{"t":"Granados","to":"/persona/Q294225"},{"t":" y Feliú i Codina se esforzaron por hacer un libreto \"auténtico\", viajando a la Murcia rural para observar el paisaje de la región, su cultura, canciones y forma de hablar. El compositor "},{"t":"Amadeo Vives","to":"/persona/Q2648593"},{"t":" fue decisivo para asegurar la primera representación de la ópera en Madrid y ayudó a coordinar la producción con el Teatro Parish."}]},{"passage_id":"Pcd4c669370a3f4d1","segments":[{"t":"Durante los ensayos orquestales, "},{"t":"Granados","to":"/persona/Q294225"},{"t":" fue ayudado por Pablo Casals, quien también dirigió una representación privada de la ópera en el "},{"t":"Teatro Principal","to":"/teatro/Q3329707"},{"t":" de Madrid antes de su estreno oficial."}]},{"passage_id":"Pb8b28faf08acd5f7","segments":[{"t":"La partitura de María del Carmen ha tenido una historia accidentada. "},{"t":"Granados","to":"/persona/Q294225"},{"t":" tenía el manuscrito original en su equipaje cuando se ahogó en el hundimiento de "},{"t":"1916","year":true},{"t":" del Sussex por un U-boat alemán. Su equipaje, y la partitura de María del Carmen, se recuperaron posteriormente del naufragio. En "},{"t":"1939","year":true},{"t":" el hijo de "},{"t":"Granados","to":"/persona/Q294225"},{"t":", Víctor, llevó la partitura original (junto con las partituras originales de otras tres obras de "},{"t":"Granados","to":"/persona/Q294225"},{"t":") a Nathaniel Shilkret y firmó un contrato para la publicación de las mismas por Shilkret y el hijo de Shilkret, Arthur. Sin embargo, objeciones suscitadas por el resto de la familia "},{"t":"Granados","to":"/persona/Q294225"},{"t":" impidieron que las obras se publicasen. En diciembre de "},{"t":"2009","year":true},{"t":" la partitura original completa de la obra fue transferida a la biblioteca de la Universidad de California en Riverside."}]}],"document_id":"De39b0043ee559198","license":"CC-BY-SA-4.0","revision":"174513909","url":"https://es.wikipedia.org/w/index.php?title=María_del_Carmen_(ópera)&oldid=174513909","history_url":"https://es.wikipedia.org/w/index.php?title=María_del_Carmen_(ópera)&action=history","retrieved_at":"2026-10-07T05:10:19Z"},"summary":{"segments":[{"text":"María del Carmen es una ópera en tres actos de Enrique Granados, basada en la obra homónima de José Feliú y Codina y estrenada en Madrid en 1898.","parts":[{"t":"María del Carmen es una ópera en tres actos de "},{"t":"Enrique Granados","to":"/persona/Q294225"},{"t":", basada en la obra homónima de "},{"t":"José Feliú y Codina","to":"/persona/Q2883060"},{"t":" y estrenada en Madrid en "},{"t":"1898","year":true},{"t":"."}],"evidence_ids":["P91cfafaafde02732"]},{"text":"La obra, ambientada en Murcia, narra un triángulo de amor entre María y sus dos pretendientes, y aunque tuvo un gran éxito en su estreno, la recepción fue menos cálida en Barcelona por el nacionalismo catalán.","parts":[{"t":"La obra, ambientada en Murcia, narra un triángulo de amor entre María y sus dos pretendientes, y aunque tuvo un gran éxito en su estreno, la recepción fue menos cálida en Barcelona por el nacionalismo catalán."}],"evidence_ids":["P91cfafaafde02732","Pfa5ad163a47b6d51"]}],"model":"bartowski/Qwen_Qwen3.5-4B-GGUF:Q5_K_M","generated_at":"2026-10-08T11:43:44Z","verified":true},"scores":[],"videos":[],"authored":[],"documents":[],"documents_total":0,"rism":[],"rism_total":0,"rism_url":null}