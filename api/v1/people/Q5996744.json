","relation":"supports"},{"claim_a":"C45f3a8d917449860","claim_b":"Cee0db23b732bdd40","relation":"supports"},{"claim_a":"C758f0dc3caa1d2eb","claim_b":"Cee0db23b732bdd40","relation":"supports"}],"n_claims":5},{"id":"C97d620d2e3f0597d","wikidata_rank":null,"references":["https://catalogo.bn.gov.ar/F/?func=direct&local_base=BNA10&doc_number=000033536"],"alternative":false,"source_families":["wikimedia"],"property":"death_date","value":"1913-04-21","value_label":null,"value_link":null,"value_type":"edtf","status":"asserted","hedge":null,"confidence":0.7,"source_kind":"structured","evidence_ids":["Pe3a3d5d66686fa61","P941da1f35c5243eb","Pfc92308c6224f3eb"],"relations":[{"claim_a":"C97d620d2e3f0597d","claim_b":"Cabc475fbcd479dcb","relation":"supports"},{"claim_a":"C97d620d2e3f0597d","claim_b":"Cb99b4feeb13ddc58","relation":"supports"},{"claim_a":"Cabc475fbcd479dcb","claim_b":"Cb99b4feeb13ddc58","relation":"supports"}],"n_claims":3},{"id":"C2d46eae4f4cb3d0d","wikidata_rank":null,"references":[],"alternative":false,"source_families":["wikimedia"],"property":"death_place","value":"Q2807","value_label":"Madrid","value_link":null,"value_type":"entity","status":"asserted","hedge":null,"confidence":0.7,"source_kind":"structured","evidence_ids":["Pe3a3d5d66686fa61","Paac7a8da85fc6eaa","Pfc92308c6224f3eb"],"relations":[{"claim_a":"C2d46eae4f4cb3d0d","claim_b":"C40adb230c1cded39","relation":"supports"},{"claim_a":"C2d46eae4f4cb3d0d","claim_b":"Cc5309da9c34c5f96","relation":"supports"},{"claim_a":"C40adb230c1cded39","claim_b":"Cc5309da9c34c5f96","relation":"supports"}],"n_claims":3}],"narratives":[{"id":"N2ac09908a8b2213a","type":"curiosidad","title":"Firma como Mefisto","summary":"Destacó como poeta y autor dramático de verso rotundo y sonoro. En alguna ocasión firmó sus obras como Mefisto.","time":null,"status":"documented","evidence_ids":["P1128cc065f12f186"]},{"id":"Na82ef5398c94ee7f","type":"contexto_histórico","title":"Avatares vitales y exilio en Argentina y Cuba","summary":"Su vida sufrió diversos avatares por los que tuvo que residir en Argentina algunos años y en Cuba, donde ejerció el cargo de administrador.","time":null,"status":"documented","evidence_ids":["P1128cc065f12f186"]}],"biography":{"paragraphs":[{"passage_id":"Pfc92308c6224f3eb","segments":[{"t":"Marcos Zapata Mañas (Ainzón, 24 de abril de "},{"t":"1842","year":true},{"t":"-Madrid, 21 de abril de "},{"t":"1913","year":true},{"t":") fue un dramaturgo y poeta español."}]},{"passage_id":"P1587683ba440d21d","segments":[{"t":"Nacido en la localidad zaragozana de Ainzón el 24 de abril de "},{"t":"1842","year":true},{"t":", trabajó como redactor de La Discusión, El Orden y Gente Vieja."}]},{"passage_id":"P1128cc065f12f186","segments":[{"t":"Su vida sufrió diversos avatares por los que tuvo que residir en Argentina algunos años y en Cuba, donde ejerció el cargo de administrador. Destacó como poeta y autor dramático de verso rotundo y sonoro. En alguna ocasión firmó sus obras como Mefisto. La mayor parte de su producción dramática son obras musicales, entre las que destacan los dramas líricos La abadía del Rosario ("},{"t":"1880","year":true},{"t":"), Un regalo de boda ("},{"t":"1885","year":true},{"t":") y La campana milagrosa ("},{"t":"1888","year":true},{"t":"), y las zarzuelas El anillo de hierro ("},{"t":"1878","year":true},{"t":"), Camoens ("},{"t":"1879","year":true},{"t":"), "},{"t":"El reloj de Lucerna","to":"/obra/Q60039813"},{"t":" ("},{"t":"1884","year":true},{"t":") y Covadonga, escrita en colaboración con Eusebio Sierra en "},{"t":"1901","year":true},{"t":". También escribió algunos dramas históricos, como La capilla de Lanuza ("},{"t":"1871","year":true},{"t":"), El castillo de Simancas ("},{"t":"1873","year":true},{"t":") o El solitario de Yuste ("},{"t":"1877","year":true},{"t":"). Su teatro es un alegato contra el despotismo provisto de largas y rotundas tiradas de versos, golpes de efecto y caracteres bravos y rudos."}]}],"document_id":"D04f145849b843dfd","license":"CC-BY-SA-4.0","revision":"154969267","url":"https://es.wikipedia.org/w/index.php?title=Marcos_Zapata_Mañas&oldid=154969267","history_url":"https://es.wikipedia.org/w/index.php?title=Marcos_Zapata_Mañas&action=history","retrieved_at":"2026-10-07T05:14:58Z"},"summary":null,"scores":[],"videos":[],"documents":[],"documents_total":0,"rism":[],"rism_total":0,"rism_url":null}