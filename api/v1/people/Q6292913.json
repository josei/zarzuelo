source_families":["wikimedia"],"property":"death_place","value":"kb:3a7395424646","value_label":"Argentina","value_link":null,"value_type":"entity","status":"disputed","hedge":null,"confidence":0.3,"source_kind":"extracted","evidence_ids":["P9827a872f3104fd8"],"relations":[{"claim_a":"C1e47102a483017a8","claim_b":"C4af3c5adf2ce8b5d","relation":"conflicts_with"},{"claim_a":"C1e47102a483017a8","claim_b":"C66ce6b4833d8d343","relation":"conflicts_with"},{"claim_a":"C1e47102a483017a8","claim_b":"C9bd3b626a2aec223","relation":"supports"},{"claim_a":"C1e47102a483017a8","claim_b":"Ca36897076dd74f0c","relation":"conflicts_with"},{"claim_a":"C4af3c5adf2ce8b5d","claim_b":"C9bd3b626a2aec223","relation":"conflicts_with"},{"claim_a":"C66ce6b4833d8d343","claim_b":"C9bd3b626a2aec223","relation":"conflicts_with"},{"claim_a":"C9bd3b626a2aec223","claim_b":"Ca36897076dd74f0c","relation":"conflicts_with"}],"n_claims":2}],"narratives":[{"id":"N2a35f5b6e622fae9","type":"recepción","title":"Respaldo de Blasco Ibáñez a sus poemas","summary":"y escribió algunos poemarios de carácter popular y costumbrista, como Chulaperías (1898), De rompe y rasga (1898) y La musa del arroyo (1911), labor en que recibió el respaldo de Vicente Blasco Ibáñez.","time":null,"status":"documented","evidence_ids":["P6b4581d8a386c3ee"]},{"id":"N632c7b8ed5c9ae31","type":"recepción","title":"Estreno de La revoltosa en el Apolo","summary":"y al año siguiente repetían colaboración con una obra de ambientación más castiza, La revoltosa, estrenada en el Teatro Apolo con un éxito clamoroso.","time":null,"status":"documented","evidence_ids":["P749e58699547225a"]}],"biography":{"paragraphs":[{"passage_id":"P6eec67e8c75d02b2","segments":[{"t":"José López Silva (Madrid, 4 de abril de "},{"t":"1861","year":true},{"t":"-Buenos Aires, 25 de marzo de "},{"t":"1925","year":true},{"t":") fue un dramaturgo y empresario teatral español."}]},{"passage_id":"P724e89136c7f32ca","segments":[{"t":"Poeta festivo y autor español del género chico, fue uno de los mejores exponentes del sainete madrileño, que, como gran conocedor del pueblo llano de Madrid, lo llevó a escena con naturalidad, especialmente en su aspecto cómico, usando muchas veces el recurso de parodiar lo trágico y lo sublime."}]},{"passage_id":"P6b4581d8a386c3ee","segments":[{"t":"De formación autodidacta, estudió en las Escuelas Pías de San Fernando, en pleno barrio madrileño de Lavapiés, del que extrajo material abundante para el género en el que se especializó: la zarzuela chica. Se dio a conocer en las páginas de Madrid Cómico, y escribió algunos poemarios de carácter popular y costumbrista, como Chulaperías ("},{"t":"1898","year":true},{"t":"), De rompe y rasga ("},{"t":"1898","year":true},{"t":") y La musa del arroyo ("},{"t":"1911","year":true},{"t":"), labor en que recibió el respaldo de Vicente Blasco Ibáñez."}]},{"passage_id":"P749e58699547225a","segments":[{"t":"Empezó a colaborar con "},{"t":"Carlos Fernández Shaw","to":"/persona/Q3660056"},{"t":" en "},{"t":"1896","year":true},{"t":" con "},{"t":"Las bravías","to":"/obra/Q5970934"},{"t":", adaptación de La fierecilla domada de Shakespeare, y al año siguiente repetían colaboración con una obra de ambientación más castiza, "},{"t":"La revoltosa","to":"/obra/Q9018899"},{"t":", estrenada en el "},{"t":"Teatro Apolo","to":"/teatro/Q5195517"},{"t":" con un éxito clamoroso. La partitura corrió a cargo de "},{"t":"Ruperto Chapí","to":"/persona/Q964682"},{"t":" y fueron principales intérpretes Isabel Bru y Emilio Mesejo en los papeles de Mari Pepa y Felipe. En la composición de este genial sainete se han detectado huellas varias del teatro clásico español y dieciochesco, en especial de Agustín Moreto, así como de "},{"t":"La verbena de la Paloma","to":"/obra/Q3214229"},{"t":"."}]},{"passage_id":"Pd85a8d091c7778b6","segments":[{"t":"López Silva y Fernández Shaw mantuvieron su colaboración en piezas posteriores como La chavala ("},{"t":"1898","year":true},{"t":"), Los buenos mozos ("},{"t":"1899","year":true},{"t":"), y El alma del pueblo ("},{"t":"1905","year":true},{"t":"). López Silva colaboró, además, con "},{"t":"José Jackson Veyán","to":"/persona/Q5940688"},{"t":", Sinesio Delgado, Julio Pellicer y "},{"t":"Carlos Arniches","to":"/persona/Q1042706"},{"t":". Con este último escribió, entre otros sainetes y revistas, Los descamisados ("},{"t":"1893","year":true},{"t":"), El coche correo ("},{"t":"1896","year":true},{"t":") y "},{"t":"El amo de la calle","to":"/obra/Q5823837"},{"t":" ("},{"t":"1910","year":true},{"t":")."}]},{"passage_id":"P9827a872f3104fd8","segments":[{"t":"A partir de "},{"t":"1915","year":true},{"t":", en que el género chico empezó a decaer en el gusto del público, López Silva se convirtió en empresario teatral y llegó a realizar varias giras por países de Hispanoamérica como Argentina, donde falleció."}]}],"document_id":"Dfa6cbbce9aeef344","license":"CC-BY-SA-4.0","revision":"172192553","url":"https://es.wikipedia.org/w/index.php?title=José_López_Silva&oldid=172192553","history_url":"https://es.wikipedia.org/w/index.php?title=José_López_Silva&action=history","retrieved_at":"2026-10-06T21:15:18Z"},"summary":{"segments":[{"text":"De formación autodidacta, se formó en las Escuelas Pías de San Fernando y extrajo material abundante del barrio de Lavapiés para sus obras cómicas y costumbristas.","parts":[{"t":"De formación autodidacta, se formó en las Escuelas Pías de San Fernando y extrajo material abundante del barrio de Lavapiés para sus obras cómicas y costumbristas."}],"evidence_ids":["P6b4581d8a386c3ee"]},{"text":"Su colaboración con Carlos Fernández Shaw le permitió estrenar obras de éxito clamoroso como La revoltosa, donde se detectan huellas del teatro clásico español y dieciochesco.","parts":[{"t":"Su colaboración con "},{"t":"Carlos Fernández Shaw","to":"/persona/Q3660056"},{"t":" le permitió estrenar obras de éxito clamoroso como "},{"t":"La revoltosa","to":"/obra/Q9018899"},{"t":", donde se detectan huellas del teatro clásico español y dieciochesco."}],"evidence_ids":["P749e58699547225a"]}],"model":"bartowski/Qwen_Qwen3.5-4B-GGUF:Q5_K_M","generated_at":"2026-10-08T11:22:17Z","verified":true},"scores":[],"videos":[],"documents":[],"documents_total":0,"rism":[],"rism_total":0,"rism_url":null}