087bb","claim_b":"Cd0ec95f2e09640da","relation":"supports"},{"claim_a":"C94d375fcf48087bb","claim_b":"Ce8597ce045c0470c","relation":"supports"},{"claim_a":"Ca34f5db1954458cd","claim_b":"Cd0ec95f2e09640da","relation":"supports"},{"claim_a":"Ca34f5db1954458cd","claim_b":"Ce8597ce045c0470c","relation":"supports"},{"claim_a":"Cd0ec95f2e09640da","claim_b":"Ce8597ce045c0470c","relation":"supports"}],"n_claims":5}],"narratives":[{"id":"Nf7397c846379aa22","type":"recepción","title":"Estreno y éxito de Un sarao y una soirée","summary":"Su primera obra, escrita mano a mano con Eduardo Lustonó, se la aceptó el empresario Francisco Arderíus, que la estrenó en el Variedades (conocido en aquel tiempo como teatro «De los Bufos») el año 1866. La pieza se titulaba Un sarao y una soirée y obtuvo un éxito muy halagüeño.","time":"1866","status":"documented","evidence_ids":["Pd953d5cfca74bfa5"]}],"biography":{"paragraphs":[{"passage_id":"P430afe2717b8f3b8","segments":[{"t":"Miguel Ramos Carrión (Zamora, 17 de mayo de "},{"t":"1848","year":true},{"t":"-Madrid, 8 de agosto de "},{"t":"1915","year":true},{"t":") fue un dramaturgo, periodista y humorista español."}]},{"passage_id":"P789ae869ae3eddf2","segments":[{"t":"Nacido el 17 de mayo de "},{"t":"1848","year":true},{"t":" en Zamora, empezó a colaborar en El Museo Universal, semanario muy leído que dirigía este gran dramaturgo del Romanticismo."}]},{"passage_id":"P4fc7f3d44ed1672f","segments":[{"t":"Fundó el semanario satírico Las Disciplinas y sus chascarrillos, versos jocosos, cuentos humorísticos llenaron las páginas de Madrid Cómico, Blanco y Negro, El Moro Muza (de La Habana), El Fisgón, Jeremías, La Publicidad y La Libertad, entre otras publicaciones periódicas. Usó los seudónimos Boabdil el Chico y Daniel."}]},{"passage_id":"Pd953d5cfca74bfa5","segments":[{"t":"Su primera obra, escrita mano a mano con "},{"t":"Eduardo Lustonó","to":"/persona/Q5493130"},{"t":", se la aceptó el empresario Francisco Arderíus, que la estrenó en el Variedades (conocido en aquel tiempo como teatro «De los Bufos») el año "},{"t":"1866","year":true},{"t":". La pieza se titulaba Un sarao y una soirée y obtuvo un éxito muy halagüeño. Desde entonces se dedicó a escribir para el teatro y sus éxitos se sucedieron durante cincuenta años, escribiendo en total cerca de setenta obras, algunas en solitario y otras en colaboración. Su última obra se titula Mi cara mitad, y fue representada en "},{"t":"1908","year":true},{"t":" en el teatro Lara. Falleció el 8 de agosto de "},{"t":"1915","year":true},{"t":" en Madrid. La ciudad de Zamora le honra con el nombre de una calle céntrica, así como el Teatro Ramos Carrión."}]},{"passage_id":"Pa9b29a021c58a8c1","segments":[{"t":"Se especializó en comedias y zarzuelas y colaboró con autores como Vital Aza, con quien formó uno de los dúos de dramaturgos cómicos más famosos de su época, con obras como "},{"t":"Los sobrinos del Capitán Grant","to":"/obra/Q5981206"},{"t":", "},{"t":"El chaleco blanco","to":"/obra/Q2887231"},{"t":", "},{"t":"La tempestad","to":"/obra/Q5968213"},{"t":", "},{"t":"Agua, azucarillos y aguardiente","to":"/obra/Q5660194"},{"t":", "},{"t":"La bruja","to":"/obra/Q3214018"},{"t":", El noveno mandamiento, La careta verde y La mamá política, entre otras, traducidas muchas de ellas al francés, alemán, inglés, sueco, portugués, italiano y hasta al esperanto; con "},{"t":"Eduardo Lustonó","to":"/persona/Q5493130"},{"t":", Eusebio Blasco, Salvador María Granés, Carlos Coello, Pina Domínguez, José Campo-Arana, "},{"t":"Estremera","to":"/persona/Q45681463"},{"t":" o Antonio "},{"t":"Ramos Martín","to":"/persona/Q87206039"},{"t":", su hijo, nacido en "},{"t":"1885","year":true},{"t":", licenciado en Filosofía y Letras, bibliotecario del Casino de Autores y secretario de la Sociedad de Autores y su Montepío, y como dramaturgo dedicado principalmente al sainete. Ramos Carrión tuvo también otro hijo dramaturgo, "},{"t":"José Ramos Martín","to":"/persona/Q87206039"},{"t":", nacido en "},{"t":"1892","year":true},{"t":", que fue también periodista."}]},{"passage_id":"Pa5f3df41bd0763ee","segments":[{"t":"Los títulos más conocidos de Ramos Carrión son las zarzuelas "},{"t":"Agua, azucarillos y aguardiente","to":"/obra/Q5660194"},{"t":" ("},{"t":"1897","year":true},{"t":"), con música de "},{"t":"Federico Chueca","to":"/persona/Q652534"},{"t":", Un sarao y una soirée ("},{"t":"1866","year":true},{"t":", con "},{"t":"Lustonó","to":"/persona/Q5493130"},{"t":"), La gallina ciega, Los sobrinos del capitán Grant, etc. Aparte de con Chueca, trabajó también con los compositores Caballero, "},{"t":"Ruperto Chapí","to":"/persona/Q964682"},{"t":" y Arrieta."}]}],"document_id":"De27db17d0c510632","license":"CC-BY-SA-4.0","revision":"168995648","url":"https://es.wikipedia.org/w/index.php?title=Miguel_Ramos_Carrión&oldid=168995648","history_url":"https://es.wikipedia.org/w/index.php?title=Miguel_Ramos_Carrión&action=history","retrieved_at":"2026-10-06T21:15:46Z"},"summary":{"segments":[{"text":"Falleció el 8 de agosto de 1915 en Madrid.","parts":[{"t":"Falleció el 8 de agosto de "},{"t":"1915","year":true},{"t":" en Madrid."}],"evidence_ids":["P430afe2717b8f3b8","P46bd0bffc3de1fd6","Pd953d5cfca74bfa5"]},{"text":"Se especializó en comedias y zarzuelas.","parts":[{"t":"Se especializó en comedias y zarzuelas."}],"evidence_ids":["Pa9b29a021c58a8c1"]},{"text":"Sus títulos más conocidos incluyen Agua, azucarillos y aguardiente (1897) y Un sarao y una soirée (1866).","parts":[{"t":"Sus títulos más conocidos incluyen "},{"t":"Agua, azucarillos y aguardiente","to":"/obra/Q5660194"},{"t":" ("},{"t":"1897","year":true},{"t":") y Un sarao y una soirée ("},{"t":"1866","year":true},{"t":")."}],"evidence_ids":["Pa5f3df41bd0763ee"]}],"model":"bartowski/Qwen_Qwen3.5-4B-GGUF:Q5_K_M","generated_at":"2026-10-09T16:48:27Z","verified":true},"scores":[],"videos":[],"documents":[{"id":"D79543593fe990486","source":"europeana","source_label":"Europeana / Hispana","title":"La marselle